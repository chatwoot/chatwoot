# CUSTOMIZAÇÃO_SYNAPSEOS — template de .env pra VPS produção
# Copie pra .env e ajuste os valores. Gere SECRET_KEY_BASE com:
#   openssl rand -hex 64

# ---------- Rails ----------
SECRET_KEY_BASE=REPLACE_ME
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true
RAILS_MAX_THREADS=5
RAILS_SERVE_STATIC_FILES=true

# ---------- URL pública do painel ----------
FRONTEND_URL=https://chatwoot.cliente.com.br
DEFAULT_LOCALE=pt_BR

# ---------- Postgres ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=REPLACE_ME_STRONG_PASSWORD
POSTGRES_STATEMENT_TIMEOUT=14s
POSTGRES_DB=chatwoot_production

# ---------- Redis ----------
REDIS_URL=redis://:REPLACE_ME_REDIS_PASS@redis:6379
REDIS_PASSWORD=REPLACE_ME_REDIS_PASS
REDIS_SENTINELS=
REDIS_OPENSSL_VERIFY_MODE=

# ---------- Storage ----------
# Deixe 'local' pra single-VPS (volume docker compartilhado web↔worker).
# Mude pra 's3_compatible' + STORAGE_* vars se for multi-node ou usar R2/S3.
ACTIVE_STORAGE_SERVICE=local

# ---------- Email (opcional — configure pra conseguir convidar agentes) ----------
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
MAILER_SENDER_EMAIL=noreply@cliente.com.br

# ---------- Porta do host (expose) ----------
# Com nginx/caddy na frente, mantenha 3000 interno. Proxy faz SSL.
WEB_PORT=3000

# ---------- Avisa (se usar) ----------
# Token não vai aqui — é por instância dentro de Settings → Inboxes.

# ---------- Tag da imagem no GHCR ----------
# Use 'latest' ou uma tag específica (ex: v0.2.0-synapseos).
SYNAPSEOS_TAG=latest
