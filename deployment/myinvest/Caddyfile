{
	admin localhost:2019
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

(direct) {
}

(cloudflare_tunnel) {
	# The tunnel origin is loopback-only. Preserve Cloudflare's authenticated
	# client IP so Chatwoot throttles visitors rather than the tunnel peer.
	header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
	header_up X-Real-IP {http.request.header.Cf-Connecting-Ip}
}

{$CADDY_SITE_SCHEME:https}://{$CADDY_SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Das eingebettete Chat-Widget lebt davon, in fremden Seiten zu laufen:
	# `widgets_controller` loescht X-Frame-Options bewusst. Ein globaler
	# Caddy-Header setzt ihn danach wieder und laesst das Chatfenster auf
	# www.myinvest-pro.de leer, waehrend der Launcher normal erscheint —
	# ein Fehlerbild, das erst beim echten Einbetten auffaellt.
	# Alles andere, insbesondere /app, bleibt klickjacking-geschuetzt.
	@protected not path /widget /widget/* /packs/* /api/v1/widget /api/v1/widget/*
	header @protected X-Frame-Options "SAMEORIGIN"

	@root path /
	redir @root /app/login 302

	handle_path /brand-assets/* {
		root * /srv/brand-assets
		file_server
	}

	handle /_agent/webhooks/chatwoot {
		uri strip_prefix /_agent
		reverse_proxy claude-agent:8080
	}

	handle {
		reverse_proxy rails:3000 {
			header_up X-Forwarded-Proto https
			import {$INGRESS_MODE:direct}
			health_uri /health
			health_interval 30s
			health_timeout 5s
			health_headers {
				X-Forwarded-Proto https
			}
		}
	}

	log {
		output stdout
		format filter {
			# Chatwoot and its widget use several custom authentication headers.
			# Drop both header maps so future credential names also fail closed.
			request>headers delete
			resp_headers delete
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			# Query values can carry widget, reset, SSO, or future token names.
			# Keep only the request path in logs so unknown credentials fail closed.
			request>uri regexp "[?].*$" ""
			wrap json
		}
	}
}
