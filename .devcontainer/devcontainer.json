{
  "name": "Chatwoot Development Codespace",
  "service": "rails",
  // 🔽 ফাইলের এক্সটেনশন .yml থেকে .yaml করা হয়েছে রুটের ফাইলের সাথে মিলানোর জন্য
  "dockerComposeFile": "../docker-compose.yaml",
  "workspaceFolder": "/app",
  "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind,consistency=cached",
  "settings": {
    "terminal.integrated.shell.linux": "/bin/zsh",
    "extensions.showRecommendationsOnlyOnDemand": true,
    "editor.formatOnSave": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "search.exclude": {
      "**/node_modules": true,
      "**/tmp": true,
      "**/log": true,
      "**/coverage": true,
      "**/public/packs": true
    }
  },
  "extensions": [
    "Shopify.ruby-lsp",
    "misogi.ruby-rubocop",
    "davidpallinder.rails-test-runner",
    "github.copilot",
    "mrmlnc.vscode-duplicate"
  ],
  "forwardPorts": [
    8025,
    3000,
    3036
  ],
  // 🔽 অটো-মাইগ্রেশন এবং ইনস্টলেশন সাময়িকভাবে অফ রাখা হলো যাতে টাইমআউট না হয়
  "postCreateCommand": "",
  "portsAttributes": {
    "3000": {
      "label": "Rails Server"
    },
    "3036": {
      "label": "Vite Dev Server"
    },
    "8025": {
      "label": "Mailhog UI"
    }
  }
}