# =========================================================================
# Synapse OS — production env template
# Copie para .env, preencha os segredos e NUNCA commite o arquivo real.
# =========================================================================

# ---- Core ---------------------------------------------------------------
# Gerar com: bundle exec rake secret (rodar num container temporário)
SECRET_KEY_BASE=REPLACE_WITH_64_CHAR_HEX

# URL pública completa da instalação (inclui https:// e domínio final).
# Deve bater com o domínio que o tráfego chega — se acessar por https://app.cliente.com
# mas FRONTEND_URL=http://localhost, Rails retorna UnsafeRedirectError em /auth.
FRONTEND_URL=https://app.seu-cliente.com
FORCE_SSL=true

# ---- Branding -----------------------------------------------------------
INSTALLATION_NAME=Synapse OS
BRAND_NAME=Synapse OS
BRAND_URL=https://synapseos.com
WIDGET_BRAND_URL=https://synapseos.com
MAILER_SENDER_EMAIL=Synapse OS <accounts@synapseos.com>

# Desabilita signup público (self-hosted 1 cliente).
ENABLE_ACCOUNT_SIGNUP=false

# ---- Postgres -----------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=synapseos_production
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
RAILS_MAX_THREADS=5

# ---- Redis --------------------------------------------------------------
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ---- SMTP ---------------------------------------------------------------
# Recomendo: Amazon SES, Postmark, ou SendGrid em produção.
SMTP_ADDRESS=email-smtp.sa-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE
SMTP_PASSWORD=REPLACE
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_DOMAIN=seu-cliente.com
SMTP_OPENSSL_VERIFY_MODE=peer

# ---- ActionMailbox (inbound emails, opcional) ---------------------------
RAILS_INBOUND_EMAIL_SERVICE=
RAILS_INBOUND_EMAIL_PASSWORD=
MAILER_INBOUND_EMAIL_DOMAIN=

# ---- Storage (produção usa S3/Cloudflare R2/Backblaze) ------------------
ACTIVE_STORAGE_SERVICE=local
# Para S3-compat:
# ACTIVE_STORAGE_SERVICE=amazon
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=sa-east-1

# ---- Observabilidade ----------------------------------------------------
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
# SENTRY_DSN=https://...@sentry.io/...

# ---- Sidekiq ------------------------------------------------------------
SIDEKIQ_CONCURRENCY=10

# ---- Hyperflow (WhatsApp BSP via N8N) -----------------------------------
# Preenchidos por inbox dentro da UI; estes env apenas servem como defaults
# se a flow do N8N consumir da instância Synapse central. Em geral fica vazio.

# ---- Rack Attack (throttle anti-abuso) ----------------------------------
ENABLE_RACK_ATTACK=true
RACK_ATTACK_LIMIT=300

# ---- Docker --------------------------------------------------------------
# Tag da imagem a puxar. Fixa em semver pra estabilidade; use :latest só em dev.
SYNAPSEOS_IMAGE=ghcr.io/SEU_USUARIO_GH/synapseos-core:latest
