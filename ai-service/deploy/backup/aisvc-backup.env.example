# Copy to /etc/aisvc-backup.env on the backup host (mode 600) and fill in.
# No secrets here: the database URL is read from the running container.
# Issue: DEV-Johnstocker/chatwoot#1

# Name of the running production ai-service container (docker ps). Required.
BACKUP_SOURCE_CONTAINER=

BACKUP_DIR=/root/backups
# Days of verified dumps to keep; older ones go only after a new dump passes.
BACKUP_KEEP_DAYS=7
# Same Postgres major version as the database (Supabase: 17).
BACKUP_IMAGE=pgvector/pgvector:pg17
BACKUP_MIN_ROWS=kb_documents=1,kb_chunks=1,business_profiles=1
RESTORE_CHECK=/opt/aisvc-backup/restore-check
