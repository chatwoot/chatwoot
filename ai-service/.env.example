# ai-service configuration. Copy to .env (or local/ai-service.env) and fill in.
# Never commit the filled-in file.

# --- Chatwoot ---------------------------------------------------------------
# Base URL ai-service uses to call Chatwoot's API (inside docker compose: http://rails:3000)
CHATWOOT_BASE_URL=http://rails:3000
# Agent Bot access token (Settings → Bots, or rails runner; see README)
CHATWOOT_BOT_TOKEN=
# Agent Bot webhook secret, used to verify X-Chatwoot-Signature
CHATWOOT_WEBHOOK_SECRET=

# --- LLM (OpenRouter or any OpenAI-compatible API) -------------------------------
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# OpenRouter model slug, e.g. one listed at https://openrouter.ai/models
LLM_MODEL=
LLM_TIMEOUT=45s
# SYSTEM_PROMPT=You are a friendly support assistant for ...

# --- Behaviour ---------------------------------------------------------------
# Comma-separated; replaces the built-in Thai/Lao/English list
# HANDOFF_KEYWORDS=คุยกับคน,แอดมิน,human
# HANDOFF_MESSAGE=ได้เลยค่ะ กำลังส่งต่อให้เจ้าหน้าที่ กรุณารอสักครู่นะคะ 🙏
# FAILURE_MESSAGE=ขออภัยค่ะ ระบบตอบอัตโนมัติขัดข้อง กำลังส่งต่อให้เจ้าหน้าที่นะคะ
HISTORY_LIMIT=20

# --- Runtime -----------------------------------------------------------------
LISTEN_ADDR=:8080
WORKERS=4
QUEUE_SIZE=256
LOG_LEVEL=info
