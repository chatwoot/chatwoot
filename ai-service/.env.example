# ai-service configuration. Copy to .env (or local/ai-service.env) and fill in.
# Never commit the filled-in file.

# --- Chatwoot ---------------------------------------------------------------
# Base URL ai-service uses to call Chatwoot's API (inside docker compose: http://rails:3000)
CHATWOOT_BASE_URL=http://rails:3000
# Agent Bot access token (Settings → Bots, or rails runner; see README)
CHATWOOT_BOT_TOKEN=
# Agent Bot webhook secret, used to verify X-Chatwoot-Signature
CHATWOOT_WEBHOOK_SECRET=

# --- LLM (OpenRouter, OpenAI, or any OpenAI-compatible API) ----------------------
# Pick ONE provider block.
#
# OpenRouter (default): many models with one key. Model slug from https://openrouter.ai/models
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
#
# OpenAI directly: key from https://platform.openai.com/api-keys,
# model id from https://platform.openai.com/docs/models (avoid models with a shutdown date)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=
#
# Fallback provider (optional): used once when the primary errors or times out.
# Any OpenAI-compatible provider, e.g. OpenAI as backup for OpenRouter.
# LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=
#
# Timeout per provider call (a fallback call gets its own timeout).
LLM_TIMEOUT=45s

# --- Settings page (/admin) --------------------------------------------------------
# Set to enable http://<host>:8080/admin (user "admin", min 12 characters).
# Provider settings saved there override the LLM_* values above.
ADMIN_PASSWORD=
SETTINGS_PATH=/data/settings.json
# SYSTEM_PROMPT=You are a friendly support assistant for ...

# --- Knowledge base (RAG) ------------------------------------------------------
# Postgres with the pgvector extension. Unset = no knowledge base; the bot
# answers from SYSTEM_PROMPT only. Use a dedicated role on a server.
# DATABASE_URL=postgres://ai_service:PASSWORD@postgres:5432/ai_service?sslmode=disable
#
# Embeddings provider (initial value; the /admin page overrides it). Must return
# 1536-dimension vectors. OpenAI text-embedding-3-large scored best on Thai in
# our sample eval. Same base URL as LLM_BASE_URL: set it on /admin and leave the
# key blank to reuse the chat key.
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=
# EMBED_MODEL=text-embedding-3-large
#
# Search tuning (measure with rag-eval before changing)
RAG_TOP_K=4
RAG_MIN_SCORE=0.3
RAG_CHUNK_RUNES=800

# --- Behaviour ---------------------------------------------------------------
# Comma-separated; replaces the built-in Thai/Lao/English list
# HANDOFF_KEYWORDS=คุยกับคน,แอดมิน,human
# HANDOFF_MESSAGE=ได้เลยค่ะ กำลังส่งต่อให้เจ้าหน้าที่ กรุณารอสักครู่นะคะ 🙏
# FAILURE_MESSAGE=ขออภัยค่ะ ระบบตอบอัตโนมัติขัดข้อง กำลังส่งต่อให้เจ้าหน้าที่นะคะ
HISTORY_LIMIT=20

# --- Runtime -----------------------------------------------------------------
LISTEN_ADDR=:8080
WORKERS=4
QUEUE_SIZE=256
LOG_LEVEL=info

# Langfuse tracing (optional; on only when all three are set).
# Region hosts: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com,
# https://jp.cloud.langfuse.com. Personal data is redacted before export.
# LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# TRACE_TEXT=redacted          # or off: no chat text at all
# TRACE_ENVIRONMENT=production

# Query rewrite on a smaller, faster model of the main provider (falls back to
# the main model if it fails). Empty uses the main model.
# REWRITE_MODEL=gpt-5.4-mini
