# =============================================================================
# InboxHub PRODUCTION — Dokploy → Environment (nivel PROYECTO)
# Dominio: https://inbox.paluhub.com
#
# Imagen Docker (opcional en proyecto; si no, en servicios rails/sidekiq):
# CHATWOOT_IMAGE_TAG=ghcr.io/pabloluna3596afk/chatwoot:develop-<SHA-validado-en-staging>
#
# Ver docs/DOKPLOY_ENV.md
# =============================================================================

CHATWOOT_IMAGE_TAG=ghcr.io/pabloluna3596afk/chatwoot:develop-0eca20d20

SECRET_KEY_BASE=CHANGE_ME_generate_with_rails_secret
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
DEPLOYMENT_ENV=production
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
DEFAULT_LOCALE=en
FORCE_SSL=true

POSTGRES_HOST=chatwoot-postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=CHANGE_ME_prod_postgres_password
REDIS_URL=redis://chatwoot-redis:6379
PRESENCE_DURATION=90

ENABLE_ACCOUNT_SIGNUP=false
ACTIVE_STORAGE_SERVICE=local

FRONTEND_URL=https://inbox.paluhub.com

MAILER_DELIVERY_METHOD=smtp
SMTP_ADDRESS=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_DOMAIN=paluhub.com
MAILER_SENDER_EMAIL=soporte@paluhub.com
