# Caddy reverse proxy with automatic HTTPS for a public VPS deploy.
#
# 1. Point DNS A-records for these subdomains at your server.
# 2. Replace the example domains below with yours.
# 3. Run Caddy on the host (or add it as a service in docker-compose) — it fetches and renews
#    Let's Encrypt certificates automatically.
#
# Maps:
#   panel.example.com  → admin panel + AI service (8080)
#   chat.example.com   → Chatwoot agent inbox     (3000)
#   traces.example.com → Langfuse (optional)      (3001)

panel.example.com {
	reverse_proxy localhost:8080
}

chat.example.com {
	reverse_proxy localhost:3000
}

traces.example.com {
	reverse_proxy localhost:3001
}
