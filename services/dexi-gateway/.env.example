# Runtime
DEXI_ENV=local
DEXI_MOCK_MODE=true            # quando true, Syonet/LLM/Meta Graph rodam em mock
LOG_LEVEL=INFO

# HTTP
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Redis (broker Celery + dedup)
REDIS_URL=redis://redis:6379/0

# Postgres (auditoria de leads)
DATABASE_URL=postgresql+psycopg://dexi:dexi@postgres:5432/dexi

# Webhooks – segredos HMAC por canal
META_APP_SECRET=change-me
GOOGLE_SHARED_SECRET=change-me
SITE_SHARED_SECRET=change-me
WHATSAPP_APP_SECRET=change-me

# Syonet (usar mock quando DEXI_MOCK_MODE=true)
SYONET_BASE_URL=https://mock.syonet.local
SYONET_USER=integration
SYONET_PASSWORD=integration
SYONET_COMPANY_ID=000000
SYONET_TIMEOUT_SECONDS=10
SYONET_DEFAULT_DAYS_TO_UPDATE_OPEN_EVENT=30

# LLM (LiteLLM multi-provider)
LLM_PROVIDER_MODEL=gpt-4o-mini         # qualquer modelo suportado pelo LiteLLM
LLM_TIMEOUT_SECONDS=15
OPENAI_API_KEY=
GOOGLE_API_KEY=
AZURE_API_KEY=
ANTHROPIC_API_KEY=

# Dedup
DEDUP_WINDOW_HOURS=24

# Chatwoot bridge — opt-in. Quando CHATWOOT_ENABLED=true:
#   - Ponte A: cada lead aceito vira contato + conversa no Chatwoot (após Syonet OK).
#   - Ponte B: webhook /webhooks/chatwoot/{tenant_id} ouve mudanças de status e
#     repassa pro Syonet como eventos ATENDIMENTO/FINALIZADO.
# Configurar no Chatwoot do cliente:
#   Settings → Integrations → Webhooks → URL = https://gateway.cliente/webhooks/chatwoot/{tenant_id}
#   com header X-Chatwoot-Signature contendo HMAC-SHA256(body, CHATWOOT_WEBHOOK_SECRET).
CHATWOOT_ENABLED=false
CHATWOOT_BASE_URL=                       # ex: https://chatwoot.cliente.com.br
CHATWOOT_API_TOKEN=                      # access_token de um agente/bot com permissão de criar conversas
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_DEFAULT_INBOX_ID=               # inbox onde os leads de portal entram (deixe vazio se for setar por tenant)
CHATWOOT_TIMEOUT_SECONDS=10
CHATWOOT_WEBHOOK_SECRET=change-me
