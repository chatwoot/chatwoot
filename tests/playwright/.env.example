# Playwright Test Configuration

# Base URL for the Chatwoot instance under test
BASE_URL=http://localhost:3000

# Admin credentials
TEST_USER_EMAIL=admin@chatwoot.com
TEST_USER_PASSWORD="Password123@#"

# Base URL used by the API request handler (defaults to BASE_URL host)
API_BASE_URL=http://localhost:3000

# Postgres connection used by DB-backed setup and cleanup helpers
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=chatwoot
DB_USER=postgres
DB_PASSWORD=postgres

# SECRET_KEY_BASE: must match the value the Chatwoot app runs with. Tests derive
# Devise reset-password tokens from it to set a new agent's password, so agent
# onboarding fails if it differs from the app's.
SECRET_KEY_BASE=

# Add additional variables as needed by specific test suites
# VARIABLE_NAME=value
