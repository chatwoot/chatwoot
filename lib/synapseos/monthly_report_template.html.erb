<% money_unit = ->(s) { amt, unit = s.to_s.rpartition(" ").values_at(0, 2); "#{amt}<span class=\"u\">#{unit}</span>" } %>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Relatório de Performance — Elisa · Junho 2026 · Audi Center Uberlândia</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#0B0B0C; --paper:#FFFFFF; --surface:#F5F5F6; --surface-2:#ECECEE;
    --line:#DCDCDF; --line-strong:#C4C4C8; --mid:#6C6C71; --faint:#9C9CA2;
    --red:#C8102E;
    --display:'Archivo',sans-serif; --body:'Inter',sans-serif; --mono:'IBM Plex Mono',monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
  body{font-family:var(--body);color:var(--ink);background:var(--surface-2);line-height:1.55;font-size:15px}
  .page{max-width:840px;margin:0 auto;background:var(--paper)}
  .pad{padding:0 64px}

  /* ---------- COVER ---------- */
  .cover{background:var(--ink);color:#fff;padding:56px 64px 48px;position:relative;overflow:hidden}
  .cover .rings{width:132px;height:auto;display:block;margin-bottom:64px}
  .cover .kicker{font-family:var(--mono);font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:#B9B9BE;margin-bottom:22px}
  .cover h1{font-family:var(--display);font-weight:800;font-size:46px;line-height:1.02;letter-spacing:-.02em;margin-bottom:10px}
  .cover h1 .ai{color:#fff;opacity:.55;font-weight:500}
  .cover .sub{font-family:var(--display);font-weight:500;font-size:18px;color:#D9D9DD;letter-spacing:-.01em}
  .cover .meta{display:flex;gap:40px;margin-top:44px;padding-top:22px;border-top:1px solid rgba(255,255,255,.16)}
  .cover .meta .item .lab{font-family:var(--mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#8A8A90;margin-bottom:5px}
  .cover .meta .item .val{font-family:var(--display);font-weight:600;font-size:15px;color:#fff}
  .cover .redline{position:absolute;left:0;bottom:0;height:4px;width:38%;background:var(--red)}

  /* ---------- SECTION ---------- */
  section{padding:44px 0 8px}
  .eyebrow{display:flex;align-items:baseline;gap:14px;margin-bottom:20px}
  .eyebrow .num{font-family:var(--mono);font-size:12px;font-weight:500;color:var(--red)}
  .eyebrow h2{font-family:var(--display);font-weight:700;font-size:20px;letter-spacing:-.01em}
  .eyebrow .rule{flex:1;height:1px;background:var(--line);align-self:center}
  .lead{font-size:15px;color:#2A2A2C;max-width:64ch;margin-bottom:26px}
  .lead strong{font-weight:600}
  .note{font-size:12.5px;color:var(--mid);font-family:var(--body)}

  /* ---------- STAT ROW ---------- */
  .stats{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--ink);border-bottom:1px solid var(--line);margin:4px 0 8px}
  .stats .s{padding:20px 22px 18px;border-right:1px solid var(--line)}
  .stats .s:last-child{border-right:none}
  .stats .s .v{font-family:var(--mono);font-weight:600;font-size:34px;letter-spacing:-.02em;line-height:1}
  .stats .s .v .u{font-size:17px;color:var(--mid);font-weight:500}
  .stats .s .k{font-size:12.5px;color:var(--mid);margin-top:9px;line-height:1.35}
  .stats .s .k b{color:var(--ink);font-weight:600}

  /* ---------- FUNNEL ---------- */
  .funnel{margin:6px 0 4px}
  .frow{display:grid;grid-template-columns:150px 1fr 132px;align-items:center;gap:16px;padding:9px 0;border-bottom:1px solid var(--line)}
  .frow:last-child{border-bottom:none}
  .frow .fl{font-size:13.5px;font-weight:500}
  .frow .fl .sm{display:block;font-family:var(--mono);font-size:10.5px;color:var(--faint);letter-spacing:.04em;font-weight:400;margin-top:1px}
  .bar{position:relative;height:16px;background:var(--surface)}
  .bar .fill{position:absolute;left:0;top:0;bottom:0;background:var(--ink)}
  .bar .cap{position:absolute;top:0;bottom:0;width:3px;background:var(--red)}
  .frow .fv{text-align:right;font-family:var(--mono)}
  .frow .fv .n{font-size:18px;font-weight:600}
  .frow .fv .p{font-size:11.5px;color:var(--mid)}

  /* ---------- TABLE ---------- */
  table{width:100%;border-collapse:collapse;font-size:13px;margin:2px 0 6px}
  thead th{font-family:var(--mono);font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--mid);font-weight:500;text-align:right;padding:9px 10px;border-bottom:1.5px solid var(--ink)}
  thead th:first-child{text-align:left}
  tbody td{padding:9px 10px;text-align:right;border-bottom:1px solid var(--line);font-family:var(--mono);font-variant-numeric:tabular-nums}
  tbody td:first-child{text-align:left;font-family:var(--body);font-weight:500}
  tbody tr.hl td{background:#FBF3F4}
  tbody tr.tot td{border-top:1.5px solid var(--ink);border-bottom:none;font-weight:600;color:var(--ink)}
  tbody tr.tot td:first-child{font-family:var(--display);font-weight:700}
  td .em{color:var(--red);font-weight:600}
  .cap-note{font-size:11.5px;color:var(--faint);margin-top:6px;font-family:var(--body)}

  /* ---------- TWO COL ---------- */
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:34px;margin-top:4px}
  .panel h3{font-family:var(--display);font-weight:600;font-size:14px;margin-bottom:12px}
  .kv{display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px solid var(--line);font-size:13.5px}
  .kv:last-child{border-bottom:none}
  .kv .kk{color:#2A2A2C}
  .kv .vv{font-family:var(--mono);font-weight:500}
  .kv .vv.z{color:var(--faint)}
  .status-panel{max-width:460px}

  /* ---------- QUALITY ---------- */
  .qbar{display:flex;height:10px;margin:8px 0 18px;background:var(--surface);overflow:hidden}
  .qbar .seg-ok{background:var(--ink)}
  .qbar .seg-noise{background:var(--red)}
  .qlegend{display:flex;gap:26px;font-size:12.5px;color:var(--mid);margin-bottom:20px}
  .qlegend .dot{display:inline-block;width:9px;height:9px;margin-right:7px;vertical-align:middle}
  .qcats{display:grid;grid-template-columns:1fr 1fr;gap:0 34px}
  .qcat{padding:8px 0;border-bottom:1px solid var(--line);font-size:13px;display:flex;justify-content:space-between;gap:12px}
  .qcat .lab{color:#2A2A2C}
  .qcat .n{font-family:var(--mono);font-weight:600;color:var(--red)}

  /* ---------- CLOSING / FOOTER ---------- */
  .method{background:var(--surface);padding:26px 64px 30px;margin-top:36px;border-top:1px solid var(--line)}
  .method .lab{font-family:var(--mono);font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--mid);margin-bottom:12px}
  .method p{font-size:12px;color:var(--mid);line-height:1.6;max-width:74ch}
  .colophon{display:flex;justify-content:space-between;align-items:center;padding:22px 64px 30px}
  .colophon img{height:26px}
  .colophon .r{font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--faint);text-align:right}

  @media print{
    body{background:#fff;font-size:12px}
    .page{max-width:none;margin:0}
    .pad,.cover,.method,.colophon{padding-left:44px;padding-right:44px}
    section{page-break-inside:avoid}
    .cover{page-break-after:always}
    @page{size:A4;margin:14mm}
  }
  @media (max-width:720px){
    .pad,.cover,.method,.colophon{padding-left:26px;padding-right:26px}
    .cover h1{font-size:34px}
    .stats{grid-template-columns:1fr}
    .stats .s{border-right:none;border-bottom:1px solid var(--line)}
    .grid2,.qcats{grid-template-columns:1fr;gap:22px}
    .frow{grid-template-columns:110px 1fr 92px;gap:10px}
    .cover .meta{flex-wrap:wrap;gap:22px}
  }
</style>
</head>
<body>
<div class="page">

  <!-- COVER -->
  <div class="cover">
    <img class="rings" src="data:image/png;base64," alt="Audi">
    <div class="kicker">Relatório de Performance · Gestora de Relacionamento Inteligente</div>
    <h1>Elisa <span class="ai">/ WhatsApp</span></h1>
    <div class="sub">Prospecção e qualificação de leads</div>
    <div class="meta">
      <div class="item"><div class="lab">Cliente</div><div class="val">Audi Center Uberlândia</div></div>
      <div class="item"><div class="lab">Período</div><div class="val"><%= r[:period_label] %></div></div>
      <div class="item"><div class="lab">Canal</div><div class="val">WhatsApp Business</div></div>
    </div>
    <div class="redline"></div>
  </div>

  <div class="pad">

    <!-- 01 VISÃO GERAL -->
    <section>
      <div class="eyebrow"><span class="num">01</span><h2>Visão geral</h2><span class="rule"></span></div>
      <p class="lead">Em junho, a Elisa prospectou <strong><%= r[:overview][:leads] %> leads</strong>, iniciou contato com <strong><%= r[:overview][:contatados] %></strong> e conduziu a qualificação das conversas no WhatsApp. Entre os leads efetivamente contatados, <strong>1 em cada 5 respondeu e avançou para qualificação</strong>, alimentando um pipeline de oportunidades identificadas ao longo do mês.</p>
      <div class="stats">
        <div class="s"><div class="v"><%= r[:overview][:resp_contatados] %><span class="u">%</span></div><div class="k"><b>Taxa de resposta</b> sobre leads contatados</div></div>
        <div class="s"><div class="v"><%= r[:overview][:resp_primeira] %><span class="u">%</span></div><div class="k"><b>Respondem já no 1º contato</b> — sem depender de reforço</div></div>
        <div class="s"><div class="v"><%= money_unit.(r[:overview][:pipeline_futuro]) %></div><div class="k"><b>Pipeline futuro</b> qualificado e registrado pela Elisa</div></div>
      </div>
    </section>

    <!-- 02 FUNIL -->
    <section>
      <div class="eyebrow"><span class="num">02</span><h2>Funil de aquisição</h2><span class="rule"></span></div>
      <p class="lead">O funil abaixo acompanha o lead da entrada até a resposta qualificada. A cobertura de contato segue em andamento — há base ainda em fila de abordagem no fechamento do mês.</p>
      <div class="funnel">
<% r[:funnel].each do |x| %>        <div class="frow"><div class="fl"><%= x[:label] %><span class="sm"><%= x[:sub] %></span></div><div class="bar"><div class="fill" style="width:<%= x[:pct] %>"></div><div class="cap" style="left:<%= x[:pct] == "1%" ? "0" : "calc(#{x[:pct]} - 3px)" %>"></div></div><div class="fv"><span class="n"><%= x[:n] %></span> <span class="p"><%= x[:pct] %></span></div></div>
<% end %>      </div>
      <div class="cap-note">Base ainda em fila de contato ao final do período: <%= r[:fila_contato] %> leads.</div>
    </section>

    <!-- 03 EFETIVIDADE -->
    <section>
      <div class="eyebrow"><span class="num">03</span><h2>Efetividade da Elisa</h2><span class="rule"></span></div>
      <p class="lead">Medida sobre os leads que a Elisa efetivamente contatou, a taxa de resposta é de <strong><%= r[:efetividade][:resp_contatados] %>%</strong>. E a resposta vem cedo: de cada 10 pessoas que engajam, quase 9 respondem já na <strong>primeira mensagem</strong>, o que indica abordagem e copy bem calibradas para o primeiro toque.</p>
      <div class="grid2">
        <div class="panel">
          <h3>Momento da resposta</h3>
          <div class="kv"><span class="kk">Responderam na 1ª mensagem</span><span class="vv"><%= r[:efetividade][:resp_primeira] %>%</span></div>
          <div class="kv"><span class="kk">Responderam após reforço</span><span class="vv"><%= r[:efetividade][:resp_apos] %>%</span></div>
        </div>
        <div class="panel">
          <h3>Duas leituras da taxa de resposta</h3>
          <div class="kv"><span class="kk">Sobre leads contatados</span><span class="vv"><%= r[:efetividade][:sobre_contatados] %>%</span></div>
          <div class="kv"><span class="kk">Sobre todos os leads recebidos</span><span class="vv"><%= r[:efetividade][:sobre_todos] %>%</span></div>
          <div class="cap-note">A diferença reflete a cobertura de contato, não a qualidade da abordagem.</div>
        </div>
      </div>
    </section>

    <!-- 04 ORIGEM -->
    <section>
      <div class="eyebrow"><span class="num">04</span><h2>Desempenho por origem</h2><span class="rule"></span></div>
      <p class="lead">Onde estão os leads que respondem. O <strong>Instagram Lead Ads</strong> concentra 73% dos leads e responde por <strong>84% de todas as respostas</strong> do mês, com a maior taxa de resposta entre os canais de mídia.</p>
      <table>
        <thead><tr><th>Origem</th><th>Leads</th><th>Contatados</th><th>% contato</th><th>Responderam</th><th>Resp./contatados</th></tr></thead>
        <tbody>
<% r[:origens].each_with_index do |x, i| %>          <tr<%= i.zero? ? ' class="hl"' : '' %>><td><%= x[:origem] %></td><td><%= x[:leads] %></td><td><%= x[:contatados] %></td><td><%= x[:pct_contato] %></td><td><%= x[:responderam] %></td><td><%= i.zero? ? "<span class=\"em\">#{x[:taxa]}</span>" : x[:taxa] %></td></tr>
<% end %>          <tr class="tot"><td>Total</td><td><%= r[:origens_total][:leads] %></td><td><%= r[:origens_total][:contatados] %></td><td><%= r[:origens_total][:pct_contato] %></td><td><%= r[:origens_total][:responderam] %></td><td><%= r[:origens_total][:taxa] %></td></tr>
        </tbody>
      </table>
      <div class="cap-note">Facebook Lead Ads responde a 13,3% quando contatado, mas teve 39% dos seus leads abordados no período — a menor cobertura entre os canais de volume.</div>
    </section>

    <!-- 05 PIPELINE -->
    <section>
      <div class="eyebrow"><span class="num">05</span><h2>Pipeline potencial</h2><span class="rule"></span></div>
      <p class="lead">Valor identificado nas conversas conduzidas pela Elisa. O pipeline está em <strong>estágio inicial</strong>: a maior parte dos leads sinaliza compra futura ou sem horizonte definido, e a demanda se concentra em SUVs e no A3.</p>
      <div class="stats">
        <div class="s"><div class="v"><%= money_unit.(r[:pipeline_potencial][:total]) %></div><div class="k"><b>Receita potencial total</b> identificada nas conversas</div></div>
        <div class="s"><div class="v"><%= money_unit.(r[:pipeline_potencial][:futura]) %></div><div class="k"><b>Compra futura</b> qualificada · <%= r[:pipeline_potencial][:futura_leads] %> leads</div></div>
        <div class="s"><div class="v"><%= money_unit.(r[:pipeline_potencial][:imediato]) %></div><div class="k"><b>Horizonte imediato</b> · <%= r[:pipeline_potencial][:imediato_leads] %> leads</div></div>
      </div>
      <div class="grid2" style="margin-top:30px">
        <div class="panel">
          <h3>Por horizonte de compra</h3>
<% r[:horizonte].each do |x| %>          <div class="kv"><span class="kk"><%= x[:label] %></span><span class="vv<%= x[:valor] == "—" ? " z" : "" %>"><%= x[:valor] %></span></div>
<% end %>        </div>
        <div class="panel">
          <h3>Demanda por modelo — topo</h3>
<% r[:demanda_modelo].each do |x| %>          <div class="kv"><span class="kk"><%= x[:modelo] %> · <%= x[:leads] %></span><span class="vv"><%= x[:valor] %></span></div>
<% end %>        </div>
      </div>
    </section>

    <!-- 06 STATUS -->
    <section>
      <div class="eyebrow"><span class="num">06</span><h2>Status do pipeline</h2><span class="rule"></span></div>
      <p class="lead">Onde estão as conversas ao final de junho. A Elisa segue conduzindo a maior parte da base, e os leads maduros são encaminhados à equipe. O pipeline ainda amadurece — a maioria com horizonte futuro.</p>
      <div class="panel status-panel">
        <h3>Leads por estágio</h3>
<% r[:pipeline_status].each do |x| %>        <div class="kv"><span class="kk"><%= x[:estagio] %></span><span class="vv<%= x[:n].to_s == "0" ? " z" : "" %>"><%= x[:n] %></span></div>
<% end %>      </div>
    </section>

    <!-- 07 VOZ DO CLIENTE -->
    <section>
      <div class="eyebrow"><span class="num">07</span><h2>Voz do cliente</h2><span class="rule"></span></div>
      <p class="lead">O que os leads trazem nas conversas. Predominam intenções de <strong>informação</strong> e <strong>troca</strong>, com poucas objeções verbalizadas — coerente com conversas em estágio inicial, antes da proposta.</p>
      <div class="grid2">
        <div class="panel">
          <h3>Intenções mais frequentes</h3>
<% r[:voz][:intencoes].each do |x| %>          <div class="kv"><span class="kk"><%= x[:label] %></span><span class="vv"><%= x[:n] %></span></div>
<% end %>        </div>
        <div class="panel">
          <h3>Objeções</h3>
<% r[:voz][:objecoes].each do |x| %>          <div class="kv"><span class="kk"><%= x[:label] %></span><span class="vv"><%= x[:n] %></span></div>
<% end %>
          <div class="cap-note">A objeção de valor tende a surgir mais adiante, após a proposta, quando o pipeline amadurecer.</div>
        </div>
      </div>
    </section>

  </div>

  <!-- COLOPHON -->
  <div class="colophon">
    <img src="data:image/png;base64," alt="Audi">
    <div class="r">Elisa · Gestora de Relacionamento Inteligente<br>Junho 2026</div>
  </div>

</div>
</body>
</html>