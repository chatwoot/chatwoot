<%= render "card", title: t("#{scope}.sessions.heading"), meta: @mobile_sessions.size do %>
  <p class="px-4 pt-3 text-label-small text-n-slate-11"><%= t("#{scope}.sessions.description") %></p>

  <% if @mobile_sessions.empty? %>
    <p class="p-4 text-body-main text-n-slate-11">
      <%= t("#{scope}.sessions.empty") %>
      <% if @web_session_count.positive? %>
        <%= t("#{scope}.sessions.web_sessions", count: @web_session_count) %>
      <% end %>
    </p>
  <% else %>
    <div class="mt-3 overflow-x-auto border-t border-n-weak">
      <%= render "table" do %>
        <thead>
          <tr>
            <% %w[app_version platform os_version device first_seen last_active].each do |column| %>
              <th><%= t("#{scope}.sessions.columns.#{column}") %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @mobile_sessions.each do |session| %>
            <tr>
              <td class="font-mono text-xs">
                <% if session.browser_version.present? %>
                  <%= session.browser_version %>
                <% else %>
                  <%= render "badge", label: t("#{scope}.sessions.legacy_build"), tone: :warning %>
                <% end %>
              </td>
              <%# device_name holds the platform family, platform_name the device model. %>
              <td><%= session.device_name.presence || '—' %></td>
              <td class="font-mono text-xs"><%= session.platform_version.presence || '—' %></td>
              <td><%= session.platform_name.presence || '—' %></td>
              <td class="whitespace-nowrap tabular-nums text-n-slate-11"><%= session.created_at.strftime('%Y-%m-%d') %></td>
              <td class="whitespace-nowrap tabular-nums">
                <% if session.last_activity_at %>
                  <%= session.last_activity_at.strftime('%Y-%m-%d %H:%M') %>
                  <span class="text-xs text-n-slate-10">(<%= t("super_admin.record.time_ago", time: time_ago_in_words(session.last_activity_at)) %>)</span>
                <% else %>
                  <span class="text-n-slate-10">—</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      <% end %>
    </div>
    <p class="border-t border-n-weak px-4 py-3 text-label-small text-n-slate-11"><%= t("#{scope}.sessions.legacy_note") %></p>
  <% end %>
<% end %>

<% if @accounts_without_push.any? %>
  <p class="text-label-small text-n-amber-11">
    <%= t("#{scope}.push_settings.none_enabled",
          count: @accounts_without_push.size,
          names: @accounts_without_push.map { |setting| account_label(setting) }.join(', ')) %>
    <%= link_to t("#{scope}.push_settings.review_link"),
                super_admin_user_diagnostics_path(user_query: @query, tab: 'push'),
                class: 'text-n-blue-11 hover:underline' %>
  </p>
<% end %>
