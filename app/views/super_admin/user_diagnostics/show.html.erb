<% scope = 'super_admin.user_diagnostics' %>
<% content_for(:title) { t("super_admin.navigation.user_diagnostics") } %>

<%= render "section",
           title: t("super_admin.navigation.user_diagnostics"),
           description: t("#{scope}.description") do %>
  <%= render "card", title: t("#{scope}.search.title") do %>
    <div class="p-4">
      <%= form_with url: super_admin_user_diagnostics_path, method: :get, local: true, class: 'flex flex-wrap items-center gap-2' do |f| %>
        <%= f.hidden_field :tab, value: @tab %>
        <%= f.text_field :user_query, value: @query, placeholder: t("#{scope}.search.placeholder"), class: ui(:input, "sm:w-80") %>
        <%= render "button", label: t("#{scope}.search.submit"), variant: :secondary, submit: f %>
      <% end %>

      <% if @query.present? && @user.nil? %>
        <p class="mt-2 text-body-main text-n-ruby-11"><%= t("#{scope}.search.not_found", query: @query) %></p>
      <% end %>

      <% if @user %>
        <div class="mt-4 flex flex-wrap items-start justify-between gap-x-4 gap-y-1 rounded-lg bg-n-slate-2 px-3.5 py-2.5">
          <div class="min-w-0">
            <p class="text-body-main">
              <span class="font-medium"><%= @user.name %></span>
              <span class="text-n-slate-11"><%= @user.email %>, <%= t("#{scope}.user.id", id: @user.id) %></span>
            </p>
            <% if @user.accounts.any? %>
              <p class="mt-0.5 text-label-small text-n-slate-11">
                <%= t("#{scope}.user.accounts",
                      accounts: @user.accounts.map { |account| t("#{scope}.user.account_with_id", name: account.name, id: account.id) }.join(", ")) %>
              </p>
            <% end %>
          </div>
          <%= link_to t("#{scope}.user.details_link"), super_admin_user_path(@user), class: 'shrink-0 text-body-main text-n-blue-11 hover:underline' %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @user %>
    <div class="space-y-6">
      <nav class="border-b border-n-weak" aria-label="<%= t("#{scope}.tabs.label") %>">
        <div class="-mb-px flex gap-5 overflow-x-auto sm:gap-6">
          <% SuperAdmin::UserDiagnosticsController::TABS.each do |tab| %>
            <%= link_to t("#{scope}.tabs.#{tab}"),
                        super_admin_user_diagnostics_path(user_query: @query, tab: tab),
                        class: 'inline-flex h-10 shrink-0 items-center border-b-2 border-transparent text-body-main text-n-slate-11 hover:text-n-slate-12 ' \
                               'aria-[current=page]:border-n-brand aria-[current=page]:font-medium aria-[current=page]:text-n-slate-12 touch:h-11',
                        aria: { current: ('page' if @tab == tab) } %>
          <% end %>
        </div>
      </nav>

      <%= render @tab, scope: scope %>
    </div>
  <% end %>
<% end %>
