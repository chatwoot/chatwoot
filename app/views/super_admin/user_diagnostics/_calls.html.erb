<%# locals: (scope:, readiness:) -%>
<%
  calls = "#{scope}.calls"
  availability_tones = { "online" => :success, "busy" => :warning, "offline" => :neutral }
  platform_icons = { "apple" => "i-ri-apple-fill", "android" => "i-ri-android-fill" }
%>

<%= render "card", title: t("#{calls}.heading") do %>
  <p class="flex items-start gap-1.5 px-4 py-3 text-label-small text-n-slate-11">
    <span class="i-lucide-phone-incoming size-3.5 shrink-0 translate-y-px"></span>
    <%= t("#{calls}.description") %>
  </p>

  <ul class="flex flex-wrap gap-x-8 gap-y-3 border-t border-n-weak px-4 py-3" aria-label="<%= t("#{calls}.platforms_label") %>">
    <% { "apple" => readiness.apple, "android" => readiness.android }.each do |platform, state| %>
      <li class="flex flex-wrap items-center gap-2 text-body-main text-n-slate-12">
        <span class="<%= platform_icons.fetch(platform) %> size-4 shrink-0 text-n-slate-11"></span>
        <%= t("#{calls}.platforms.#{platform}") %>
        <% if state.configured %>
          <%= render "badge", label: t("#{calls}.configured"), tone: :success %>
        <% else %>
          <%= render "badge", label: t("#{calls}.not_configured"), tone: :danger %>
        <% end %>
        <span class="text-label-small tabular-nums text-n-slate-11"><%= t("#{calls}.devices", count: state.devices) %></span>
        <% unless state.configured %>
          <span class="basis-full text-label-small text-n-slate-11"><%= t("#{calls}.credentials.#{platform}") %></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <% if readiness.memberships.any? %>
    <div class="overflow-x-auto border-t border-n-weak">
      <%= render "table" do %>
        <thead>
          <tr>
            <% %w[account voice ringing status rings].each do |column| %>
              <th><%= t("#{calls}.account_columns.#{column}") %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% readiness.memberships.each do |membership| %>
            <tr>
              <td>
                <span class="inline-flex items-center gap-1.5">
                  <span class="max-w-60 truncate"><%= membership.account.name %></span>
                  <span class="shrink-0 text-n-slate-9"><%= t("#{scope}.user.id", id: membership.account.id) %></span>
                </span>
              </td>
              <% [membership.voice_enabled, membership.ringing_enabled].each do |enabled| %>
                <td><%= render "badge", label: t("#{calls}.#{enabled ? 'on' : 'off'}"), tone: enabled ? :success : :neutral %></td>
              <% end %>
              <td><%= render "badge", label: t("#{calls}.availability.#{membership.availability}"), tone: availability_tones.fetch(membership.availability, :neutral) %></td>
              <td>
                <% if readiness.rings?(membership) %>
                  <%= render "badge", label: t("#{calls}.rings"), tone: :success %>
                <% else %>
                  <%= render "badge", label: t("#{calls}.app_open_only"), tone: :warning %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      <% end %>
    </div>
  <% end %>
<% end %>
