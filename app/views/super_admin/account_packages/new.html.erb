<%#
# New

Assign a package to an account.

## Local variables:

- `account`: The Account the package is being assigned to
- `account_package`: The new AccountPackage being created
- `packages`: Active Package records to choose from
%>

<% content_for(:title) do %>
  Assign Package - <%= @account.name %>
<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title">
    Assign Package
  </h1>
  <div>
    <%= link_to('Back to Accounts', super_admin_accounts_path, class: 'button') %>
  </div>
</header>

<section class="main-content__body">
  <%= render 'form', account: @account, account_package: @account_package, packages: @packages %>
</section>
