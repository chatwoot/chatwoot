<%= form_with(
  model: [:super_admin, @profile],
  url: @profile.persisted? ? super_admin_prospecting_scoring_profile_path(@profile) : super_admin_prospecting_scoring_profiles_path,
  method: @profile.persisted? ? :patch : :post,
  class: 'grid max-w-3xl gap-5 rounded border border-slate-200 bg-white p-6'
) do |form| %>
  <% if @profile.errors.any? %>
    <div class="rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <%= @profile.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <label class="grid gap-1">
    <span class="text-sm font-medium text-slate-700">Name</span>
    <%= form.text_field :name, class: 'rounded border border-slate-300 px-3 py-2 text-sm' %>
  </label>

  <label class="flex items-center gap-2 text-sm text-slate-700">
    <%= form.check_box :default %>
    Use as default profile
  </label>

  <div class="grid gap-3 sm:grid-cols-2">
    <% Autonomia::Prospecting::ScoringProfile::DEFAULT_WEIGHTS.each do |key, default_value| %>
      <label class="grid gap-1">
        <span class="text-sm font-medium text-slate-700"><%= key.humanize %></span>
        <%= number_field_tag "autonomia_prospecting_scoring_profile[weights][#{key}]", @profile.weights_with_defaults[key] || default_value, min: 0, max: 100, class: 'rounded border border-slate-300 px-3 py-2 text-sm' %>
      </label>
    <% end %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit 'Save profile', class: 'rounded bg-woot-500 px-4 py-2 text-sm font-medium text-white hover:bg-woot-600' %>
    <%= link_to 'Cancel', super_admin_prospecting_scoring_profiles_path, class: 'text-sm text-slate-600 hover:underline' %>
  </div>
<% end %>
