<div class="flex flex-col gap-4 mb-6">
  <form method="get" action="<%= super_admin_debug_center_url %>" class="bg-white p-4 rounded-lg shadow-sm outline outline-1 outline-n-container flex flex-wrap gap-3 items-end">
    <input type="hidden" name="tab" value="runtime" />
    <div class="flex flex-col gap-1">
      <label class="text-xs text-n-slate-11">Log level</label>
      <%= select_tag :log_level, options_for_select(%w[ALL INFO WARN ERROR FATAL], @log_level), class: 'w-full h-9 px-3 text-sm border border-n-weak rounded bg-white focus:outline-none focus:border-woot-500' %>
    </div>
    <button type="submit" class="inline-flex items-center h-9 px-4 bg-woot-500 hover:bg-woot-600 text-white text-sm font-medium rounded">Apply</button>
    <%= link_to 'Refresh', super_admin_debug_center_url(tab: 'runtime', log_level: @log_level), class: "inline-flex items-center h-9 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium rounded" %>
  </form>
  <div class="text-xs text-slate-500">
    Source: <code class="bg-slate-100 px-1 rounded"><%= @log_file %></code> &mdash; showing the most recent <%= @log_lines.size %> matching lines.
  </div>
</div>

<% if @log_lines.any? %>
  <div class="bg-slate-900 rounded-lg shadow-sm overflow-x-auto">
    <pre class="text-xs leading-5 font-mono text-slate-200 p-4 whitespace-pre-wrap break-words m-0"><%= @log_lines.join %></pre>
  </div>
<% else %>
  <div class="bg-white p-10 rounded-lg shadow-sm outline outline-1 outline-n-container text-center">
    <p class="text-slate-500 m-0">No log lines found for the selected level.</p>
    <% unless File.exist?(@log_file) %>
      <p class="text-xs text-slate-400 mt-1">The log file does not exist yet. Logs may be streamed to stdout in this environment.</p>
    <% end %>
  </div>
<% end %>