<%# locals: (user:) -%>
<%
  routed_user = user.becomes(User)
  email_diagnostics = Email::SesSuppressionService.configured?
  suppression = params[:suppression]
  blocked_hint = t("super_admin.users.email_suppression.test_email_blocked_hint.#{suppression}") if suppression.in?(%w[bounce complaint])
  item = "w-full cursor-pointer rounded-lg px-2.5 py-2 text-start text-body-main text-n-slate-12 hover:bg-n-slate-2 active:bg-n-slate-3 aria-busy:cursor-wait aria-busy:bg-n-slate-2"
  heading = "px-2.5 pb-1 pt-2 text-xs font-medium uppercase tracking-wider text-n-slate-10"
%>

<% unless email_diagnostics || user.confirmed? %>
  <%= render "button",
             label: t("super_admin.users.resend_confirmation.button"),
             post_to: [:resend_confirmation, namespace, routed_user],
             variant: :secondary,
             form_class: "contents" %>
<% end %>

<details class="relative" data-dropdown>
  <%= render "button",
             as: :summary,
             label: t("super_admin.actions.more"),
             icon_end: "i-lucide-chevron-down size-4",
             variant: :secondary,
             extra: "list-none [&::-webkit-details-marker]:hidden" %>
  <div class="rounded-xl border border-n-weak bg-n-solid-1 absolute end-0 top-full z-40 mt-1 w-64 max-w-[calc(100vw-2rem)] p-1 shadow-lg">
    <% if email_diagnostics %>
      <p class="<%= heading %>"><%= t("super_admin.users.email_suppression.menu") %></p>
      <%= button_to(
            t("super_admin.users.email_suppression.check_button"),
            [:check_email_suppression, namespace, routed_user],
            method: :post,
            class: item,
            form_class: "block",
            data: { pending_label: t("super_admin.users.email_suppression.pending.check") },
          ) %>

      <% if suppression == "bounce" %>
        <button type="button" class="<%= item %>" data-dialog-open="unblock-email-dialog">
          <%= t("super_admin.users.email_suppression.clear_button") %>
        </button>
      <% else %>
        <%= render "blocked_action",
                   label: t("super_admin.users.email_suppression.clear_button"),
                   hint: case suppression
                         when "complaint" then t("super_admin.users.email_suppression.complaint_hint")
                         when "not_suppressed" then t("super_admin.users.email_suppression.not_blocked_hint")
                         else t("super_admin.users.email_suppression.check_first_hint")
                         end %>
      <% end %>

      <% if blocked_hint %>
        <%= render "blocked_action", label: t("super_admin.users.email_suppression.test_email_button"), hint: blocked_hint %>
      <% else %>
        <%= button_to(
              t("super_admin.users.email_suppression.test_email_button"),
              [:send_test_email, namespace, routed_user],
              method: :post,
              class: item,
              form_class: "block",
              data: { pending_label: t("super_admin.users.email_suppression.pending.send") },
            ) %>
      <% end %>

      <% unless user.confirmed? %>
        <% if blocked_hint %>
          <%= render "blocked_action", label: t("super_admin.users.resend_confirmation.button"), hint: blocked_hint %>
        <% else %>
          <%= button_to(
                t("super_admin.users.resend_confirmation.button"),
                [:resend_confirmation, namespace, routed_user],
                method: :post,
                class: item,
                form_class: "block",
                data: { pending_label: t("super_admin.users.email_suppression.pending.send") },
              ) %>
        <% end %>
      <% end %>
      <hr class="mx-1.5 my-1 border-n-weak">
    <% end %>

    <p class="<%= heading %>"><%= t("super_admin.users.support") %></p>
    <button type="button" class="<%= item %>" data-dialog-open="impersonate-dialog">
      <%= t("super_admin.users.impersonate") %>
    </button>
  </div>
</details>

<% if email_diagnostics && suppression == "bounce" %>
  <dialog id="unblock-email-dialog" aria-labelledby="unblock-email-dialog-title" class="rounded-xl border border-n-weak bg-n-solid-1 w-[calc(100%-2rem)] max-w-md p-5 text-n-slate-12 shadow-xl backdrop:bg-modal-backdrop-light dark:backdrop:bg-modal-backdrop-dark">
    <h2 class="text-heading-2" id="unblock-email-dialog-title">
      <%= t("super_admin.users.email_suppression.clear_dialog.title", email: user.email) %>
    </h2>
    <p class="mt-2 text-body-main text-n-slate-11"><%= t("super_admin.users.email_suppression.clear_dialog.body", brand_name: GlobalConfig.get_value("BRAND_NAME").presence || "Chatwoot") %></p>
    <div class="mt-6 flex justify-end gap-2">
      <form method="dialog">
        <%= render "button", label: t("super_admin.users.email_suppression.clear_dialog.cancel"), variant: :secondary, type: "submit" %>
      </form>
      <%= render "button",
                 label: t("super_admin.users.email_suppression.clear_dialog.confirm"),
                 post_to: [:clear_email_suppression, namespace, routed_user],
                 data: { pending_label: t("super_admin.users.email_suppression.pending.clear") } %>
    </div>
  </dialog>
<% end %>

<dialog id="impersonate-dialog" aria-labelledby="impersonate-dialog-title" data-backdrop-close class="rounded-xl border border-n-weak bg-n-solid-1 w-[calc(100%-2rem)] max-w-md p-0 text-n-slate-12 shadow-xl backdrop:bg-modal-backdrop-light dark:backdrop:bg-modal-backdrop-dark">
  <div class="p-5">
    <div class="flex items-start justify-between gap-3">
      <h2 class="text-heading-2" id="impersonate-dialog-title"><%= t("super_admin.users.impersonate_dialog.title", name: user.name) %></h2>
      <form method="dialog">
        <%= render "icon_button", extra: "-me-2 -mt-1.5", type: "submit", aria: { label: t("super_admin.actions.close") } do %>
          <span class="i-lucide-x size-4"></span>
        <% end %>
      </form>
    </div>
    <%= render "alert", extra: "mt-3 flex items-start gap-2" do %>
      <span class="i-lucide-triangle-alert mt-0.5 size-4 shrink-0"></span>
      <%= t("super_admin.users.impersonate_caution", name: user.name) %>
    <% end %>
    <p class="mt-3 text-body-main text-n-slate-11"><%= t("super_admin.users.impersonate_dialog.private_window_hint") %></p>
    <div class="mt-6 flex flex-wrap justify-end gap-2">
      <%= render "button",
                 label: t("super_admin.users.copy_impersonation_link"),
                 post_to: impersonation_link_super_admin_user_path(user),
                 variant: :secondary,
                 form: { data: { copy_link: true, copied_label: t("super_admin.users.impersonation_link_copied"), failed_label: t("super_admin.users.impersonation_link_failed") } } %>
      <%= render "button",
                 label: t("super_admin.users.impersonate"),
                 post_to: impersonate_super_admin_user_path(user),
                 form: { target: "_blank", rel: "noopener" } %>
    </div>
  </div>
</dialog>
