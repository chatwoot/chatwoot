<%#
# Show

This view is the template for the show page.
It renders the attributes of a resource,
as well as a link to its edit page.

## Local variables:

- `page`:
  An instance of [Administrate::Page::Show][1].
  Contains methods for accessing the resource to be displayed on the page,
  as well as helpers for describing how each attribute of the resource
  should be displayed.

[1]: http://www.rubydoc.info/gems/administrate/Administrate/Page/Show
%>

<% content_for(:title) { t("administrate.actions.show_resource", name: page.page_title) } %>
<% content_for(:toast_flashes, "true") %>
<%
  user = page.resource
  fields = page.attributes.values.flatten.index_by(&:name)
  accounts_count = fields["account_users"].data.size
  mfa_status = user.mfa_enabled? ? t("super_admin.users.mfa_enabled") : t("super_admin.users.mfa_disabled")
  tabs = [
    { key: "overview", label: t("super_admin.record.overview"), icon: "i-lucide-layout-list" },
    { key: "accounts", label: t("super_admin.users.accounts"), icon: "i-lucide-building-2", count: accounts_count }
  ]
  active = active_tab(tabs)
  badges = capture do
%>
  <%= render_field fields["type"] %>
  <span class="<%= ui(user.confirmed? ? :badge_success : :badge_warning) %>"><%= user.confirmed? ? t("super_admin.users.confirmed") : t("super_admin.users.unconfirmed") %></span>
<% end %>

<%= render "hero",
           title: user.name,
           back: display_resource_name(page.resource_name),
           avatar: fields["avatar_url"].avatar_url,
           badges: badges,
           details: { "i-lucide-hash" => user.id, "i-lucide-mail" => user.email },
           facts: [
             { label: t("super_admin.users.accounts"), value: number_with_delimiter(accounts_count), icon: "i-lucide-building-2 text-n-blue-10" },
             { label: t("super_admin.users.mfa"), value: mfa_status, icon: "i-lucide-shield-check text-n-teal-10" },
             { label: t("super_admin.record.created"), value: l(user.created_at.to_date, format: "%b %-d, %Y"), icon: "i-lucide-calendar text-n-iris-10" },
             { label: t("super_admin.record.last_updated"), value: t("super_admin.record.time_ago", time: time_ago_in_words(user.updated_at)), icon: "i-lucide-history text-n-amber-11" }
           ] do %>
  <%= link_to(
    t("administrate.actions.edit"),
    [:edit, namespace, user.becomes(User)],
    class: ui(:button),
  ) if authorized_action? user, :edit %>
  <%= render "email_actions", user: user %>
<% end %>

<%= render "tabs", tabs: tabs, active: active %>

<div data-tab-panel="overview" <%= "hidden" unless active == "overview" %>>
  <div class="space-y-6 pt-6">
    <%= render "card", title: t("super_admin.record.profile") do %>
      <%= render "attributes", page: page, attributes: fields.values_at("id", "name", "display_name", "email", "unconfirmed_email", "type", "confirmed_at", "created_at", "updated_at") do %>
        <%= render "attribute", label: t("super_admin.users.mfa"), id: "mfa_enabled" do %>
          <span class="<%= ui(user.mfa_enabled? ? :badge_success : :badge) %>"><%= mfa_status %></span>
        <% end %>
      <% end %>
    <% end %>

    <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-2">
      <%= render "card", title: t("super_admin.users.access_token") do %>
        <div class="px-4 pb-2 pt-3 text-body-main"><%= render_field fields["access_token"], page: page %></div>
      <% end %>

      <%= render "impersonate", user: user %>
    </div>
  </div>
</div>

<div data-tab-panel="accounts" <%= "hidden" unless active == "accounts" %>>
  <div class="space-y-6 pt-6">
    <%= render_field fields["account_users"], page: page %>
    <%= render "super_admin/shared/account_user_form", page: page, resource_type: "user" %>
  </div>
</div>
