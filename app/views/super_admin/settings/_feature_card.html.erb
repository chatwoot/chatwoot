<%# locals: (attrs:, url: nil, locked: false) -%>
<%= content_tag (url ? :a : :div),
                href: url,
                class: class_names(ui(:card), "group flex gap-3 p-3.5", "items-center" => !locked, "hover:border-n-blue-7 hover:bg-n-blue-2" => url),
                data: { filter_item: true } do %>
  <span class="<%= class_names(ui(:logo_tile), "text-n-slate-9 grayscale" => locked) %>">
    <span class="<%= attrs['icon'] || 'i-lucide-sliders-horizontal' %> size-5"></span>
  </span>
  <span class="min-w-0 flex-1">
    <span class="flex items-center gap-1.5">
      <span class="truncate text-heading-3 text-n-slate-12"><%= attrs['name'] %></span>
      <% if attrs['enterprise'] %>
        <span class="<%= ui(:badge_accent) %>">EE</span>
      <% end %>
    </span>
    <span class="<%= class_names("block text-label-small text-n-slate-11", "truncate" => !locked) %>" title="<%= attrs['description'] %>"><%= attrs['description'] || t('super_admin.settings.default_description') %></span>
    <% if locked %>
      <%= render ChatwootApp.enterprise? ? "upgrade_button_enterprise" : "upgrade_button_community" %>
    <% end %>
  </span>
  <% if locked %>
    <span class="i-lucide-lock size-4 shrink-0 text-n-slate-9" title="<%= t('super_admin.settings.locked') %>"></span>
  <% elsif url %>
    <span class="i-lucide-settings size-4 shrink-0 text-n-slate-9 group-hover:text-n-blue-11" title="<%= t('super_admin.settings.configure') %>"></span>
  <% else %>
    <span class="i-lucide-circle-check size-4 shrink-0 text-n-teal-10" title="<%= t('super_admin.features.enabled') %>"></span>
  <% end %>
<% end %>
