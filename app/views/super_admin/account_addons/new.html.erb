<%#
# New

Activate an add-on for an account.

## Local variables:

- `account`: The Account the add-on is being activated for
- `account_addon`: The new AccountAddon being created
- `account_package`: The account's current AccountPackage (or nil)
- `addons`: Active Addon records (the catalog) to choose from
%>

<% content_for(:title) do %>
  Add Add-on - <%= @account.name %>
<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title">
    Add Add-on
  </h1>
  <div>
    <%= link_to('Back to Account', super_admin_account_path(@account), class: 'button') %>
  </div>
</header>

<section class="main-content__body">
  <%= render 'form', account: @account, account_addon: @account_addon, account_package: @account_package, addons: @addons %>
</section>
