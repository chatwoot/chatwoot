<%#
# Account Add-on Form Partial

Renders the "activate an add-on for an account" flow: lists the available active
add-ons from the catalog (with their limit boosts) for the Super Admin to pick,
plus a start date and a duration mode. The period is resolved by the model into
starts_at/ends_at and must fall within the account's current base package period.

## Local variables:

- `account`: The Account the add-on is being activated for
- `account_addon`: The AccountAddon being created/edited
- `account_package`: The account's current AccountPackage (or nil)
- `addons`: Active Addon records (the catalog) to choose from
%>

<div class="space-y-6">
  <% if account_package.blank? %>
    <div class="mb-4 border border-slate-100 rounded-md p-4 bg-slate-25">
      <p class="text-sm text-slate-700">
        This account has no current active package. An add-on can only be
        activated within an active package period.
        <%= link_to('Assign a package first', [:new, namespace, :account_package, account_id: account.id], class: 'text-woot-500') %>.
      </p>
    </div>
  <% else %>
    <div class="mb-4 border border-slate-100 rounded-md p-4 bg-slate-25">
      <h2 class="text-sm font-medium text-slate-700 mb-2">Base Package</h2>
      <p class="text-sm text-slate-700">
        <strong><%= account_package.package.name %></strong>
        &nbsp;&middot;&nbsp;
        <%= account_package.starts_at.strftime('%b %d, %Y') %>
        &rarr;
        <%= account_package.ends_at.strftime('%b %d, %Y') %>
      </p>
      <p class="text-xs text-slate-500 mt-1">
        The add-on period must fall within this package period.
      </p>
    </div>
  <% end %>

  <% if account_addon.persisted? %>
    <div class="mb-4 border border-slate-100 rounded-md p-4 bg-slate-25">
      <h2 class="text-sm font-medium text-slate-700 mb-2">Current Add-on</h2>
      <p class="text-sm text-slate-700">
        <strong><%= account_addon.addon.name %></strong>
        &nbsp;&middot;&nbsp;
        <%= account_addon.starts_at.strftime('%b %d, %Y') %>
        &rarr;
        <%= account_addon.ends_at.strftime('%b %d, %Y') %>
      </p>
      <div class="mt-3">
        <%= link_to(
          'Remove Add-on',
          [namespace, account_addon],
          class: 'button',
          method: :delete,
          data: { confirm: 'Remove this add-on? Its limit boosts will no longer count.' }
        ) %>
      </div>
    </div>
  <% end %>

  <%= form_for([namespace, account_addon], html: { class: 'form' }) do |f| %>
    <%= f.hidden_field(:account_id) %>

    <% if account_addon.errors.any? %>
      <div id="error_explanation">
        <h2>
          <%= pluralize(account_addon.errors.count, 'error') %> prohibited this add-on from being saved:
        </h2>
        <ul>
          <% account_addon.errors.full_messages.each do |message| %>
            <li class="flash-error"><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <fieldset class="mb-6">
      <legend class="text-sm font-medium text-slate-700 mb-2">Select Add-on</legend>

      <% if addons.any? %>
        <div class="grid grid-cols-1 gap-3">
          <% addons.each do |addon| %>
            <label class="block cursor-pointer rounded-md border p-4 <%= account_addon.addon_id == addon.id ? 'border-woot-500 bg-woot-25' : 'border-slate-100' %>">
              <div class="flex items-start">
                <%= radio_button_tag('account_addon[addon_id]', addon.id, account_addon.addon_id == addon.id, class: 'mt-1') %>
                <div class="ml-3">
                  <span class="font-medium text-slate-800"><%= addon.name %></span>
                  <% if addon.description.present? %>
                    <p class="text-sm text-slate-600 mt-1"><%= addon.description %></p>
                  <% end %>
                  <dl class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1 text-sm text-slate-700">
                    <div class="flex justify-between">
                      <dt class="text-slate-500">Users boost</dt>
                      <dd class="font-medium"><%= addon.users_limit || '—' %></dd>
                    </div>
                    <div class="flex justify-between">
                      <dt class="text-slate-500">Channels boost</dt>
                      <dd class="font-medium"><%= addon.channels_limit || '—' %></dd>
                    </div>
                    <div class="flex justify-between">
                      <dt class="text-slate-500">Contacts boost</dt>
                      <dd class="font-medium"><%= addon.contacts_limit || '—' %></dd>
                    </div>
                    <div class="flex justify-between">
                      <dt class="text-slate-500">Conversations boost</dt>
                      <dd class="font-medium"><%= addon.conversations_limit || '—' %></dd>
                    </div>
                    <div class="flex justify-between">
                      <dt class="text-slate-500">Campaign msgs boost</dt>
                      <dd class="font-medium"><%= addon.campaign_messages_limit || '—' %></dd>
                    </div>
                  </dl>
                </div>
              </div>
            </label>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-slate-600">
          No active add-ons available.
          <%= link_to('Create one first', new_super_admin_addon_path, class: 'text-woot-500') %>.
        </p>
      <% end %>
    </fieldset>

    <% if account_package.present? %>
      <fieldset class="mb-6">
        <legend class="text-sm font-medium text-slate-700 mb-2">Active Period</legend>

        <div class="field-unit field-unit--date field-unit--required">
          <div class="field-unit__label">
            <%= f.label :start_date, 'Start date' %>
          </div>
          <div class="field-unit__field">
            <%= f.date_field :start_date, value: account_addon.start_date || account_addon.starts_at&.to_date %>
          </div>
        </div>

        <div class="mt-4 space-y-3">
          <label class="block">
            <span class="inline-flex items-center">
              <%= radio_button_tag('account_addon[duration_type]', 'fixed_months', account_addon.duration_type == 'fixed_months', class: 'mr-2') %>
              <span class="text-sm text-slate-700">Fixed duration</span>
            </span>
          </label>
          <div class="ml-6 flex items-center gap-2 text-sm text-slate-700">
            <%= number_field_tag 'account_addon[duration_months]', account_addon.duration_months, min: 1, class: 'w-20' %>
            <span>months (1, 3 or 6)</span>
          </div>

          <label class="block">
            <span class="inline-flex items-center">
              <%= radio_button_tag('account_addon[duration_type]', 'until_package_end', account_addon.duration_type == 'until_package_end', class: 'mr-2') %>
              <span class="text-sm text-slate-700">Until the end of the base package (<%= account_package.ends_at.strftime('%b %d, %Y') %>)</span>
            </span>
          </label>
          <% if account_addon.persisted? && account_addon.duration_type == 'until_package_end' %>
            <p class="ml-6 text-xs text-slate-500">
              This snapshots the package end at save time. If the base package is
              later extended, save this add-on again to re-extend it.
            </p>
          <% end %>

          <label class="block">
            <span class="inline-flex items-center">
              <%= radio_button_tag('account_addon[duration_type]', 'custom', account_addon.duration_type == 'custom', class: 'mr-2') %>
              <span class="text-sm text-slate-700">Custom duration</span>
            </span>
          </label>
          <div class="ml-6 flex items-center gap-2 text-sm text-slate-700">
            <span>End date</span>
            <%= date_field_tag 'account_addon[end_date]', account_addon.end_date || account_addon.ends_at&.to_date %>
          </div>
        </div>
      </fieldset>

      <div class="form-actions">
        <%= f.submit(account_addon.persisted? ? 'Update Add-on' : 'Add Add-on') %>
      </div>
    <% end %>
  <% end %>
</div>
