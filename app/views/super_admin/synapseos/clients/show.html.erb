<% content_for(:title) do %>Synapse client: <%= @client['slug'] || params[:slug] %><% end %>

<%
  active_tab = params[:tab].presence || 'overview'
  tabs = [
    %w[overview Overview],
    %w[yaml YAML],
    %w[workflows Workflows],
    %w[history History]
  ]
  tab_link_class = lambda do |tab_key|
    base = 'inline-block px-3 py-2 text-sm border-b-2 -mb-px cursor-pointer'
    if active_tab == tab_key
      "#{base} border-woot-500 text-woot-500 font-medium"
    else
      "#{base} border-transparent text-slate-700 hover:text-woot-500"
    end
  end

  whatsapp = @client['whatsapp']
  is_deployed = @client['deployed'] == true || @client['status'].to_s == 'deployed'
  current_status = @client['status'].presence || (@client['deployed'] ? 'deployed' : 'not_deployed')
  poll_status = !!flash[:poll_status]
%>

<header class="main-content__header" role="banner">
  <div class="flex items-center justify-between w-full">
    <div class="flex items-center">
      <h1 class="main-content__page-title m-0 mr-4" id="page-title">
        <%= @client['name'].presence || @client['slug'] || params[:slug] %>
        <span class="text-sm text-slate-500 font-normal ml-2"><%= @client['slug'] %></span>
      </h1>
      <span id="js-status-pill"
            data-slug="<%= params[:slug] %>"
            data-poll-status="<%= poll_status ? 'true' : 'false' %>"
            data-status-url="<%= deploy_status_super_admin_synapseos_client_path(slug: params[:slug], format: :json) %>"
            class="<%= synapseos_status_pill(current_status) %>"><%= current_status %></span>
    </div>
    <div class="flex items-center gap-2">
      <%= button_to (is_deployed ? 'Re-deploy' : 'Deploy'),
                    deploy_super_admin_synapseos_client_path(slug: params[:slug]),
                    method: :post,
                    form: { class: 'inline', data: { 'js-deploy-form': 'true' } },
                    class: 'js-deploy-btn inline-flex items-center px-3 py-1.5 bg-green-600 text-white text-sm font-medium rounded hover:bg-green-700 disabled:opacity-50' %>
      <% if is_deployed %>
        <%= button_to 'Undeploy',
                      undeploy_super_admin_synapseos_client_path(slug: params[:slug]),
                      method: :post,
                      data: { confirm: 'Tem certeza? Isso vai remover os workflows do n8n.' },
                      form: { class: 'inline', data: { 'js-deploy-form': 'true' } },
                      class: 'js-deploy-btn inline-flex items-center px-3 py-1.5 bg-orange-600 text-white text-sm font-medium rounded hover:bg-orange-700 disabled:opacity-50' %>
      <% end %>
      <%= button_to 'Build (preview)',
                    build_super_admin_synapseos_client_path(slug: params[:slug]),
                    method: :post,
                    form: { class: 'inline', data: { 'js-deploy-form': 'true' } },
                    class: 'js-deploy-btn inline-flex items-center px-3 py-1.5 bg-cyan-600 text-white text-sm font-medium rounded hover:bg-cyan-700 disabled:opacity-50' %>
      <%= link_to 'Edit',
                  edit_super_admin_synapseos_client_path(slug: params[:slug]),
                  class: 'inline-flex items-center px-3 py-1.5 bg-woot-500 text-white text-sm font-medium rounded hover:bg-woot-600' %>
      <%= link_to 'Delete',
                  super_admin_synapseos_client_path(slug: params[:slug]),
                  method: :delete,
                  data: { confirm: 'Are you sure? This deletes the client.yaml file in the agentic panel.' },
                  class: 'inline-flex items-center px-3 py-1.5 bg-red-600 text-white text-sm font-medium rounded hover:bg-red-700' %>
      <%= link_to '← Back to clients', super_admin_synapseos_clients_path, class: 'text-sm text-woot-500 hover:underline ml-2' %>
    </div>
  </div>
</header>

<section class="main-content__body">
  <nav class="border-b border-slate-100 mb-4">
    <ul class="flex gap-2">
      <% tabs.each do |key, label| %>
        <li>
          <%= link_to label,
                      super_admin_synapseos_client_path(slug: params[:slug], tab: key),
                      class: tab_link_class.call(key) %>
        </li>
      <% end %>
    </ul>
  </nav>

  <% if active_tab == 'overview' %>
    <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3">
      <% [
        ['Slug', @client['slug']],
        ['Name', @client['name']],
        ['Full name', @client['full_name']],
        ['Persona (full)', @client['persona_full']],
        ['Persona (short)', @client['persona_short']],
        ['Dealer name', @client['dealer_name']],
        ['Dealer address', @client['dealer_address']],
        ['City', @client['city']],
        ['Runbook base URL', @client['runbook_base_url']],
        ['Chatwoot account', @client['chatwoot_account_id']]
      ].each do |label, value| %>
        <div class="border-b border-slate-50 pb-2">
          <dt class="text-xs uppercase text-slate-500 tracking-wide"><%= label %></dt>
          <dd class="text-sm text-slate-800 mt-1"><%= value.presence || '—' %></dd>
        </div>
      <% end %>

      <div class="border-b border-slate-50 pb-2 md:col-span-2">
        <dt class="text-xs uppercase text-slate-500 tracking-wide">WhatsApp Provider</dt>
        <dd class="text-sm text-slate-800 mt-1">
          <% if whatsapp.is_a?(Hash) && whatsapp['provider'].present? %>
            <span class="<%= synapseos_status_pill('available') %>"><%= whatsapp['provider'] %></span>
            <span class="ml-2 text-slate-600">credential: <code class="text-xs"><%= whatsapp['credential'] || '—' %></code></span>
          <% else %>
            <span class="text-slate-500">—</span>
          <% end %>
        </dd>
      </div>
    </dl>
  <% end %>

  <% if active_tab == 'yaml' %>
    <div class="bg-slate-900 text-slate-50 p-4 rounded text-xs overflow-auto">
      <pre><code><%= Psych.dump(@client) %></code></pre>
    </div>
  <% end %>

  <% if active_tab == 'workflows' %>
    <% agents = (@client['agents'] || {}) %>
    <% client_workflows = (@client['workflows'] || {}) %>
    <% agent_workflows = (@client['agent_workflows'] || {}) %>
    <table>
      <thead>
        <tr>
          <th scope="col">Agent</th>
          <th scope="col">Display name</th>
          <th scope="col">Status</th>
          <th scope="col">Workflows</th>
        </tr>
      </thead>
      <tbody>
        <% agents.each do |agent_slug, agent_cfg| %>
          <% next unless agent_cfg.is_a?(Hash) %>
          <% template = (@templates || {})[agent_slug] || {} %>
          <% display_name = template['display_name'] || agent_slug %>
          <% status = template['status'] || (agent_cfg['enabled'] ? 'available' : 'planned') %>
          <% workflows = (agent_workflows[agent_slug] || client_workflows[agent_slug] || []) %>
          <tr>
            <td class="cell-data"><code class="text-xs"><%= agent_slug %></code></td>
            <td class="cell-data"><%= display_name %></td>
            <td class="cell-data"><span class="<%= synapseos_status_pill(status) %>"><%= status %></span></td>
            <td class="cell-data">
              <% if workflows.is_a?(Array) && workflows.any? %>
                <% workflows.each do |wid| %>
                  <span class="inline-block px-2 py-0.5 mr-1 mb-1 rounded bg-slate-100 text-slate-700 text-xs"><%= wid %></span>
                <% end %>
              <% elsif workflows.is_a?(Hash) && workflows.any? %>
                <% workflows.each do |k, v| %>
                  <span class="inline-block px-2 py-0.5 mr-1 mb-1 rounded bg-slate-100 text-slate-700 text-xs"><%= k %>: <%= v %></span>
                <% end %>
              <% else %>
                <span class="text-slate-500 text-xs">—</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% if active_tab == 'history' %>
    <%= render 'history', slug: params[:slug] %>
  <% end %>
</section>

<script>
(function() {
  var pill = document.getElementById('js-status-pill');
  if (!pill) { return; }
  var shouldPoll = pill.getAttribute('data-poll-status') === 'true';
  if (!shouldPoll) { return; }

  var statusUrl = pill.getAttribute('data-status-url');
  var deployButtons = document.querySelectorAll('.js-deploy-btn');
  deployButtons.forEach(function(btn) { btn.disabled = true; });

  var pillBaseClasses = {
    deployed:     'inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700',
    not_deployed: 'inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700',
    error:        'inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-700',
    pending:      'inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-700'
  };

  var maxAttempts = 100; // 100 * 3s = 5 min
  var attempts = 0;

  function setPill(status) {
    pill.textContent = status;
    pill.className = pillBaseClasses[status] || pillBaseClasses.pending;
  }

  function stopPolling() {
    deployButtons.forEach(function(btn) { btn.disabled = false; });
  }

  async function poll() {
    attempts += 1;
    if (attempts > maxAttempts) {
      setPill('error');
      stopPolling();
      return;
    }
    try {
      var res = await fetch(statusUrl, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' });
      var json = await res.json();
      var status = json.status || 'pending';
      setPill(status);
      if (status === 'deployed' || status === 'not_deployed' || status === 'error') {
        stopPolling();
        return;
      }
    } catch (e) {
      setPill('error');
      stopPolling();
      return;
    }
    setTimeout(poll, 3000);
  }

  setPill('pending');
  setTimeout(poll, 1500);
})();
</script>
