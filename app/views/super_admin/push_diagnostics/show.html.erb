<% content_for(:title) { t("super_admin.navigation.push_diagnostics") } %>
<% field_label = "text-label-small text-n-slate-11" %>

<%= render "section",
           label: t("super_admin.navigation.monitor"),
           items: monitor_nav_items,
           title: t("super_admin.navigation.push_diagnostics"),
           description: t("super_admin.push_diagnostics.description") do %>
  <%= render "card", title: t("super_admin.push_diagnostics.lookup_title") do %>
    <div class="p-4">
      <%= form_with url: super_admin_push_diagnostics_path, method: :get, local: true, class: 'flex flex-wrap items-center gap-2' do |f| %>
        <%= f.text_field :user_query, value: @query, placeholder: t("super_admin.push_diagnostics.lookup_placeholder"), class: ui(:input, "sm:w-80") %>
        <%= render "button", label: t("super_admin.push_diagnostics.lookup"), variant: :secondary, submit: f %>
      <% end %>

      <% if @query.present? && @user.nil? %>
        <p class="mt-2 text-body-main text-n-ruby-11"><%= t("super_admin.push_diagnostics.no_user_for_query", query: @query) %></p>
      <% end %>

      <% if @user %>
        <div class="mt-4 rounded-lg bg-n-slate-2 px-3.5 py-2.5">
          <p class="text-body-main">
            <span class="font-medium"><%= @user.name %></span>
            <span class="text-n-slate-11"><%= @user.email %>, <%= t("super_admin.push_diagnostics.user_id", id: @user.id) %></span>
          </p>
          <% if @user.accounts.any? %>
            <p class="mt-0.5 text-label-small text-n-slate-11">
              <%= t("super_admin.push_diagnostics.user_accounts",
                    accounts: @user.accounts.map { |account| t("super_admin.push_diagnostics.account_with_id", name: account.name, id: account.id) }.join(", ")) %>
            </p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @user %>
    <%= render "card", title: t("super_admin.push_diagnostics.subscriptions_title", count: @subscriptions.count) do %>
      <div class="p-4">
        <p class="text-label-small text-n-amber-11">
          <%= t("super_admin.push_diagnostics.real_push_warning") %>
        </p>

        <% if @subscriptions.empty? %>
          <p class="mt-3 text-body-main text-n-slate-11"><%= t("super_admin.push_diagnostics.no_subscriptions") %></p>
        <% else %>
          <%= form_with url: super_admin_push_diagnostics_path, method: :post, local: true, class: 'mt-4' do |f| %>
            <%= f.hidden_field :user_id, value: @user.id %>

            <div class="mb-4 max-w-2xl space-y-3">
              <div>
                <%= label_tag :push_title, t("super_admin.push_diagnostics.push_title"), class: field_label %>
                <%= text_field_tag :push_title,
                                   params[:push_title].presence || Notification::PushTestService.default_title,
                                   class: ui(:input, "mt-1") %>
              </div>
              <div>
                <%= label_tag :push_body, t("super_admin.push_diagnostics.push_body"), class: field_label %>
                <%= text_area_tag :push_body,
                                  params[:push_body].presence || Notification::PushTestService.default_body,
                                  rows: 2,
                                  class: ui(:input, "mt-1") %>
                <p class="mt-1 <%= field_label %>"><%= t("super_admin.push_diagnostics.push_body_hint") %></p>
              </div>
            </div>

            <div class="rounded-xl border border-n-weak bg-n-solid-1 overflow-x-auto">
              <%= render "table" do %>
                <thead>
                  <tr>
                    <th><input type="checkbox" class="<%= ui(:checkbox) %>" aria-label="<%= t("super_admin.actions.select_all") %>" data-check-toggle></th>
                    <th><%= t("super_admin.push_diagnostics.columns.id") %></th>
                    <th><%= t("super_admin.push_diagnostics.columns.type") %></th>
                    <th><%= t("super_admin.push_diagnostics.columns.device_endpoint") %></th>
                    <th><%= t("super_admin.push_diagnostics.columns.push_token") %></th>
                    <th><%= t("super_admin.push_diagnostics.columns.device_details") %></th>
                    <th><%= t("super_admin.push_diagnostics.columns.created") %></th>
                    <th><%= t("super_admin.push_diagnostics.columns.last_updated") %></th>
                  </tr>
                </thead>
                <tbody>
                  <% @subscriptions.each do |sub| %>
                    <% attrs = (sub.subscription_attributes || {}).stringify_keys %>
                    <% if sub.browser_push? %>
                      <% endpoint = attrs['endpoint'].to_s %>
                      <% host = (begin; URI.parse(endpoint).host; rescue URI::InvalidURIError; nil; end) %>
                      <% device_display = host.presence || endpoint.presence || '—' %>
                      <% token_display = endpoint.present? ? "…#{endpoint.last(6)}" : '—' %>
                    <% else %>
                      <% device_display = attrs['device_id'].present? ? "…#{attrs['device_id'].to_s.last(6)}" : '—' %>
                      <% token_display = attrs['push_token'].present? ? "…#{attrs['push_token'].to_s.last(6)}" : '—' %>
                    <% end %>
                    <% extra_attrs = attrs.except('endpoint', 'p256dh', 'auth', 'push_token', 'device_id') %>
                    <tr>
                      <td><%= check_box_tag 'subscription_ids[]', sub.id, false, id: "subscription_#{sub.id}", class: ui(:checkbox) %></td>
                      <td class="tabular-nums"><%= sub.id %></td>
                      <td><%= sub.subscription_type %></td>
                      <td class="break-all font-mono text-xs"><%= device_display %></td>
                      <td class="break-all font-mono text-xs"><%= token_display %></td>
                      <td class="text-xs">
                        <% if extra_attrs.present? %>
                          <% extra_attrs.each do |k, v| %>
                            <div><span class="text-n-slate-11"><%= k %>:</span> <span class="font-mono"><%= v.to_s.truncate(40) %></span></div>
                          <% end %>
                        <% else %>
                          <span class="text-n-slate-10">—</span>
                        <% end %>
                      </td>
                      <td class="whitespace-nowrap tabular-nums"><%= sub.created_at.strftime('%Y-%m-%d %H:%M') %></td>
                      <td class="whitespace-nowrap tabular-nums">
                        <%= sub.updated_at.strftime('%Y-%m-%d %H:%M') %>
                        <span class="text-xs text-n-slate-10">(<%= t("super_admin.record.time_ago", time: time_ago_in_words(sub.updated_at)) %>)</span>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              <% end %>
            </div>

            <div class="mt-4 flex flex-wrap gap-2">
              <%= render "button", label: t("super_admin.push_diagnostics.send_test"), submit: f %>
              <%= render "button",
                         label: t("super_admin.push_diagnostics.delete_selected"),
                         variant: :danger,
                         submit: f,
                         formaction: destroy_subscriptions_super_admin_push_diagnostics_path,
                         formmethod: 'post',
                         data: { confirm: t("super_admin.push_diagnostics.delete_confirm") } %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if @results.present? %>
      <%= render "card", title: t("super_admin.push_diagnostics.results_title") do %>
        <div class="overflow-x-auto rounded-b-xl">
          <%= render "table" do %>
            <thead>
              <tr>
                <th><%= t("super_admin.push_diagnostics.columns.sub_id") %></th>
                <th><%= t("super_admin.push_diagnostics.columns.type") %></th>
                <th><%= t("super_admin.push_diagnostics.columns.device") %></th>
                <th><%= t("super_admin.push_diagnostics.columns.push_token") %></th>
                <th><%= t("super_admin.push_diagnostics.columns.status") %></th>
                <th><%= t("super_admin.push_diagnostics.columns.details") %></th>
              </tr>
            </thead>
            <tbody>
              <% @results.each do |r| %>
                <tr class="align-top">
                  <td class="tabular-nums"><%= r[:id] %></td>
                  <td><%= r[:type] %></td>
                  <td class="break-all font-mono text-xs"><%= r[:device] %></td>
                  <td class="break-all font-mono text-xs"><%= r[:token_tail] %></td>
                  <td><%= render "badge", label: r[:status].to_s.titleize, tone: { success: :success, failure: :danger }.fetch(r[:status], :neutral) %></td>
                  <td class="whitespace-pre-wrap break-all font-mono text-xs"><%= r[:message] %></td>
                </tr>
              <% end %>
            </tbody>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
