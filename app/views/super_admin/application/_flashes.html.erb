<%#
# Flash Partial

Renders flash messages on every page. A page that sets `content_for(:toast_flashes)`
gets them as toasts in the corner instead of a banner above the content.
%>

<% if flash.any? %>
  <% toast = content_for?(:toast_flashes) %>
  <%= tag.div class: class_names("space-y-2", toast ? "pointer-events-none fixed end-4 top-16 z-50 w-[calc(100%-2rem)] max-w-md" : "pt-4"),
              data: { flashes: true, toast_flashes: toast.presence } do %>
    <% flash.each do |type, message| %>
      <%= render "alert", type: type, extra: ("pointer-events-auto shadow-lg transition-opacity duration-300" if toast) do %>
        <%= message.to_s.html_safe %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
