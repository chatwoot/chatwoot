<%# Has to sit inside a `data-filter-scope`: superadmin.js wires these controls to the items in it. %>
<%# locals: (search: true, states: nil, bulk: false) -%>
<div class="mb-3 flex flex-wrap items-center gap-2">
  <% if search %>
    <div class="relative min-w-40 flex-1 sm:max-w-xs">
      <span class="i-lucide-search pointer-events-none absolute start-3 top-1/2 size-4 -translate-y-1/2 text-n-slate-10"></span>
      <input type="search" class="<%= ui(:input, "ps-9") %>" placeholder="<%= t("super_admin.features.filter") %>" aria-label="<%= t("super_admin.features.filter") %>" data-filter-input>
    </div>
  <% end %>
  <% if states %>
    <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="<%= t("super_admin.filters.label") %>">
      <% states.each_with_index do |(state, label), index| %>
        <%= render "chip", label: label, selected: index.zero?, data: { filter_state: state } %>
      <% end %>
    </div>
  <% end %>
  <% if bulk %>
    <div class="flex items-center gap-2 sm:ms-auto">
      <span class="text-label-small tabular-nums text-n-slate-11" data-check-count="<%= t("super_admin.features.selected_count") %>"></span>
      <%= render "button", label: t("super_admin.actions.select_all"), variant: :secondary, data: { check_all: true } %>
      <%= render "button", label: t("super_admin.actions.clear"), variant: :secondary, data: { check_none: true } %>
    </div>
  <% end %>
</div>
