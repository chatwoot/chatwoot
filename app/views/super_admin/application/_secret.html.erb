<%# locals: (value:, boxed: false) -%>
<% button = "#{ui(:icon_button)} size-7" %>
<%= tag.span class: class_names("max-w-full items-center gap-1 font-mono text-xs text-n-slate-11", boxed ? "flex h-9 rounded-lg border border-n-weak bg-n-slate-2 pe-1 ps-3 dark:bg-n-solid-2" : "inline-flex"),
             data: { secret: value } do %>
  <span class="<%= boxed ? "min-w-0 flex-1 select-none truncate" : "min-w-0 break-all" %>" data-secret-text><%= "•" * (value.to_s.length.nonzero? || 10) %></span>
  <button type="button" class="<%= button %>" data-secret-toggle aria-label="<%= t("super_admin.actions.toggle_secret") %>">
    <span class="i-lucide-eye size-4"></span>
    <span class="i-lucide-eye-off hidden size-4"></span>
  </button>
  <button type="button" class="<%= button %>" data-secret-copy aria-label="<%= t("super_admin.actions.copy") %>">
    <span class="i-lucide-copy size-4"></span>
    <span class="i-lucide-check hidden size-4 text-n-teal-10"></span>
  </button>
<% end %>
