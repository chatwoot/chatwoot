<%# locals: (page:) -%>
<%= form_for([namespace, page.resource]) do |f| %>
  <% if page.resource.errors.any? %>
    <div class="<%= ui(:flash_error) %> mb-3" id="error_explanation">
      <h2 class="text-heading-3">
        <%= t(
          "administrate.form.errors",
          pluralized_errors: pluralize(page.resource.errors.count, t("administrate.form.error")),
          resource_name: display_resource_name(page.resource_name, singular: true)
        ) %>
      </h2>
      <ul class="mt-1 list-inside list-disc">
        <% page.resource.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="<%= ui(:card) %>">
    <%= yield f %>

    <div class="sticky bottom-0 z-10 flex items-center gap-2 rounded-b-xl border-t border-n-weak bg-n-solid-1 px-5 py-3">
      <%= f.submit class: ui(:button) %>
    </div>
  </div>
<% end %>
