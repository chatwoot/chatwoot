<%# locals: (label:, icon: nil, help_url: nil, premium: false, disabled: false) -%>
<label class="<%= class_names("flex min-h-10 items-center gap-2.5 rounded-lg border border-n-weak px-3 py-1.5 has-[:checked]:border-n-blue-6 has-[:checked]:bg-n-blue-2", disabled ? "cursor-not-allowed" : "cursor-pointer hover:bg-n-alpha-2") %>" data-filter-item>
  <% if icon %>
    <span class="<%= icon %> size-4 shrink-0 text-n-slate-11"></span>
  <% end %>
  <span class="flex min-w-0 flex-1 items-center gap-2">
    <span class="truncate"><%= label %></span>
    <% if premium %>
      <span class="i-lucide-crown size-3.5 shrink-0 text-n-amber-11"></span>
    <% end %>
  </span>
  <%= render "help_link", url: help_url if help_url %>
  <%= yield %>
</label>
