<%# locals: (title:, description: nil, back: nil) -%>
<header class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3 pb-5 pt-6 lg:pt-8">
  <div class="min-w-0">
    <%= render "back_link", label: back if back %>
    <h1 class="text-heading-1 text-n-slate-12"><%= title %></h1>
    <% if description %>
      <p class="mt-1 max-w-2xl text-body-main tabular-nums text-n-slate-11"><%= description %></p>
    <% end %>
  </div>
  <div class="flex flex-wrap items-center gap-2"><%= yield %></div>
</header>
