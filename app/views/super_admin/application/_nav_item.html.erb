<%# locals: (item:) -%>
<li>
  <%= link_to item[:url],
              class: "flex min-h-9 items-center gap-2.5 rounded-lg px-2.5 text-body-main text-n-slate-11 hover:bg-n-alpha-2 hover:text-n-slate-12 aria-[current=page]:bg-n-alpha-2 aria-[current=page]:font-medium aria-[current=page]:text-n-slate-12 touch:min-h-11",
              aria: { current: ("page" if item[:active]) } do %>
    <span class="<%= item[:icon] %> size-4 shrink-0"></span>
    <span class="truncate"><%= item[:label] %></span>
    <% if item[:external] %>
      <span class="i-lucide-arrow-up-right ms-auto size-3.5 shrink-0 text-n-slate-9"></span>
    <% end %>
  <% end %>
</li>
