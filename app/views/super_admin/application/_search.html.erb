<%# locals: (search_term:, current_filter:, resource_name:) -%>
<form class="relative min-w-52 flex-1" role="search" data-search-filter="<%= current_filter %>">
  <label class="sr-only" for="search"><%= t("administrate.search.label", resource: resource_name) %></label>
  <span class="i-lucide-search pointer-events-none absolute start-3 top-1/2 size-4 -translate-y-1/2 text-n-slate-10"></span>
  <input class="<%= ui(:input) %> min-h-10 pe-9 ps-9 [&::-webkit-search-cancel-button]:hidden"
         id="search"
         type="search"
         name="search"
         placeholder="<%= t("administrate.search.label", resource: resource_name) %>"
         value="<%= search_term %>">

  <% if search_term.present? %>
    <%= link_to({ search: ("#{current_filter}:" if current_filter) }, class: "#{ui(:icon_button)} absolute end-1 top-1/2 -translate-y-1/2", title: t("administrate.search.clear")) do %>
      <span class="i-lucide-x size-4"></span>
    <% end %>
  <% end %>
</form>
