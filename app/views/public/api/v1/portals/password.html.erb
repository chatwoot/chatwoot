<!DOCTYPE html>
<html lang="<%= html_lang_attribute(I18n.locale) %>">
  <head>
    <%= render 'layouts/portal_head', skip_analytics: true %>
    <meta name="robots" content="noindex, nofollow">
  </head>
  <body class="font-default bg-white dark:bg-slate-900">
    <main class="flex flex-col items-center justify-center min-h-screen px-4 py-16 antialiased" role="main">
      <div class="flex flex-col items-center w-full max-w-sm gap-6">
        <% if @portal.logo.present? %>
          <img src="<%= url_for(@portal.logo) %>" class="w-auto h-10" draggable="false" alt="" />
        <% end %>
        <div class="flex flex-col gap-1 text-center">
          <span class="text-sm font-semibold text-slate-600 dark:text-slate-300"><%= @portal.localized_value('name', @locale) %></span>
          <h1 class="text-xl font-semibold text-slate-900 dark:text-white"><%= I18n.t('public_portal.password.title') %></h1>
          <p class="text-sm text-slate-600 dark:text-slate-300"><%= I18n.t('public_portal.password.description') %></p>
        </div>
        <%= form_with url: public_portal_unlock_path(@portal.slug), method: :post, class: 'flex flex-col w-full gap-3' do |form| %>
          <%= form.hidden_field :return_to, value: @return_to %>
          <%= form.password_field :password,
                required: true,
                autofocus: true,
                autocomplete: 'current-password',
                placeholder: I18n.t('public_portal.password.placeholder'),
                'aria-label': I18n.t('public_portal.password.placeholder'),
                class: 'w-full h-10 px-3 text-sm bg-white border border-solid rounded-lg border-slate-200 text-slate-900 dark:bg-slate-800 dark:border-slate-700 dark:text-white focus:outline-none focus:border-woot-500' %>
          <% if @invalid_password %>
            <p class="text-sm text-red-600 dark:text-red-400" role="alert"><%= I18n.t('public_portal.password.invalid') %></p>
          <% end %>
          <%= form.submit I18n.t('public_portal.password.submit'),
                class: 'w-full h-10 text-sm font-medium text-white rounded-lg cursor-pointer bg-woot-500 hover:bg-woot-600' %>
        <% end %>
      </div>
    </main>
  </body>
</html>
