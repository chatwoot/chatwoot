<% content_for :head do %>
  <title><%= I18n.t('public_portal.tickets.index.title') %> | <%= @portal.localized_value('name', @locale) %></title>
<% end %>

<div class="w-full max-w-3xl px-4 mx-auto md:px-8 py-10 md:py-14">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-3xl font-semibold text-slate-900 dark:text-white"><%= I18n.t('public_portal.tickets.index.title') %></h1>
    <a href="/hc/<%= @portal.slug %>/tickets/new" class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-medium text-white rounded-lg bg-slate-900 dark:bg-white dark:text-slate-900">
      <%= I18n.t('public_portal.tickets.index.new_ticket') %>
    </a>
  </div>

  <% if @tickets.empty? %>
    <p class="mt-8 text-slate-600 dark:text-slate-400"><%= I18n.t('public_portal.tickets.index.empty') %></p>
  <% else %>
    <ul class="flex flex-col gap-3 mt-8">
      <% @tickets.each do |ticket| %>
        <li>
          <a href="/hc/<%= @portal.slug %>/tickets/<%= ticket.id %>" class="flex flex-col gap-2 p-5 border rounded-lg border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800">
            <div class="flex flex-wrap items-center gap-3">
              <span class="text-sm font-medium text-slate-500 dark:text-slate-400">#<%= ticket.conversation.display_id %></span>
              <span class="px-2 py-0.5 text-xs font-medium rounded-full <%= ticket_status_category_classes(ticket.status_category) %>">
                <%= I18n.t("public_portal.tickets.status_categories.#{ticket.status_category}") %>
              </span>
            </div>
            <span class="text-lg font-medium text-slate-900 dark:text-white"><%= ticket.subject %></span>
            <span class="text-sm text-slate-500 dark:text-slate-400">
              <%= I18n.t('public_portal.tickets.index.updated_at', time: l(ticket.updated_at, format: :long)) %>
            </span>
          </a>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
