<!-- ═══════════════════════════════════════════════════════════
     INTEGRAÇÃO: JUSMONITORIA
     ═══════════════════════════════════════════════════════════ -->
<section class="integration-section">
  <div class="container">
    <div class="integration-split reverse">
      <div class="integration-info">
        <div class="section-label reveal">Integração</div>
        <h2 class="section-title reveal reveal-delay-1">
          JusMonitorIA<br>
          <span style="color: #f472b6;">Monitoramento Jurídico Inteligente</span>
        </h2>
        <p class="section-desc reveal reveal-delay-2">
          O <strong>JusMonitorIA</strong> é o cérebro jurídico — monitora processos, publicações do
          Diário de Justiça e responde leads com informações atualizadas sobre andamentos processuais.
          O Chatwit encaminha eventos e entrega respostas de volta ao lead.
        </p>
        <p class="section-desc reveal reveal-delay-3" style="margin-top: 16px;">
          Ativação por <strong>labels</strong> (<code style="color: var(--accent); background: var(--accent-glow); padding: 2px 8px; border-radius: 4px; font-size: 13px;">jusmonitoria_monitoramento</code>):
          quando uma label é adicionada a uma conversa, o JusMonitorIA começa a monitorar os processos
          associados ao contato. Eventos de contato, mensagens e resolução são encaminhados automaticamente.
        </p>
        <div class="integration-tags reveal reveal-delay-4">
          <span class="integration-tag">Bot Auto-Provisionado</span>
          <span class="integration-tag">Labels Automáticas</span>
          <span class="integration-tag">Webhook Bidirecional</span>
          <span class="integration-tag">Monitoramento Processual</span>
          <span class="integration-tag">Diário de Justiça</span>
          <span class="integration-tag">Sync 15s + Async</span>
        </div>
      </div>
      <div class="integration-visual reveal reveal-delay-2">
        <div class="integration-diagram" style="border-color: rgba(244,114,182,0.2);">
          <div class="diagram-flow">
            <div class="diagram-node">
