<!-- ═══════════════════════════════════════════════════════════
     INTEGRAÇÃO: SOCIALWISE
     ═══════════════════════════════════════════════════════════ -->
<section class="integration-section" id="integracoes">
  <div class="container">
    <div class="integration-split">
      <div class="integration-info">
        <div class="section-label reveal">Integração</div>
        <h2 class="section-title reveal reveal-delay-1">
          SocialWise<br>
          <span style="color: var(--accent)">Motor de Fluxo Inteligente</span>
        </h2>
        <p class="section-desc reveal reveal-delay-2">
          O SocialWise é o <strong>cérebro</strong> da automação. Ele processa a lógica de fluxo,
          debounce de mensagens e respostas interativas. O Chatwit atua como <strong>carteiro</strong>,
          entregando e recebendo mensagens via WhatsApp, Instagram e Facebook.
        </p>
        <p class="section-desc reveal reveal-delay-3" style="margin-top: 16px;">
          Duas vias de comunicação: <strong>Sync</strong> (webhook com ponte aberta por 30s) e
          <strong>Async</strong> (Agent Bot API para respostas que ultrapassam o timeout). Bot global
          auto-provisionado no startup com token seguro.
        </p>
        <div class="integration-tags reveal reveal-delay-4">
          <span class="integration-tag">Sync 30s Webhook</span>
          <span class="integration-tag">Async Agent Bot</span>
          <span class="integration-tag">Debounce Inteligente</span>
          <span class="integration-tag">Botões Interativos</span>
          <span class="integration-tag">Mídia via Upload</span>
          <span class="integration-tag">Templates WhatsApp</span>
        </div>
      </div>
      <div class="integration-visual reveal reveal-delay-2">
        <div class="integration-diagram">
