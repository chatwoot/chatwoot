<%= render "super_admin/application/standalone", heading: t("installation.onboarding.heading") do %>
  <%= form_tag('/installation/onboarding', class: 'space-y-4') do %>
    <div>
      <label for="user_name" class="text-label"><%= t("installation.onboarding.name") %></label>
      <%= text_field :user, :name, placeholder: t("installation.onboarding.name_placeholder"), required: true, class: ui(:input, "mt-1 min-h-10") %>
    </div>

    <div>
      <label for="user_company" class="text-label"><%= t("installation.onboarding.company") %></label>
      <%= text_field :user, :company, placeholder: t("installation.onboarding.company_placeholder"), required: true, class: ui(:input, "mt-1 min-h-10") %>
    </div>

    <div>
      <label for="user_email" class="text-label"><%= t("installation.onboarding.email") %></label>
      <%= email_field :user, :email, placeholder: t("installation.onboarding.email_placeholder"), required: true, class: ui(:input, "mt-1 min-h-10") %>
    </div>

    <div>
      <label for="user_password" class="text-label"><%= t("installation.onboarding.password") %></label>
      <%= password_field :user, :password, placeholder: t("installation.onboarding.password_placeholder"), required: true, class: ui(:input, "mt-1 min-h-10") %>
    </div>

    <label class="flex items-start gap-2 text-body-main" for="subscribe_to_updates">
      <%= check_box_tag "subscribe_to_updates", 'true', true, class: ui(:checkbox, "mt-0.5") %>
      <%= t("installation.onboarding.subscribe") %>
    </label>

    <%= render "super_admin/application/button", label: t("installation.onboarding.submit"), type: "submit", extra: "h-10 w-full" %>
  <% end %>
<% end %>
