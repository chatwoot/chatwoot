<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="robots" content="noindex">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for(:title) %> - <%= application_title %></title>
  <%= render "theme" %>
  <%= render "stylesheet" %>
  <%= vite_client_tag %>
  <%= vite_stylesheet_tag 'superadmin.scss' %>
  <%= vite_javascript_tag 'superadmin' %>
  <%= yield :head %>
  <%= csrf_meta_tags %>
  <%= render "prefetch" %>
</head>
<body class="min-h-full bg-n-background text-n-slate-12 antialiased">
  <div class="pointer-events-none fixed inset-x-0 top-0 z-50 h-0.5 origin-left scale-x-0 bg-n-brand" data-page-progress></div>
  <%= render "navigation" %>
  <main class="mx-auto w-full max-w-[120rem] px-[clamp(1rem,3vw,3rem)] pb-12">
    <%= render "flashes" %>
    <%= yield %>
  </main>
  <%= render "javascript" %>
</body>
</html>
