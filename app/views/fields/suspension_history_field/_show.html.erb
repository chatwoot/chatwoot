<% if field.events.present? %>
  <div class="overflow-x-auto rounded-b-xl">
    <table class="<%= ui(:table) %>">
      <thead>
        <tr>
          <th><%= t('super_admin.account_suspension.history.suspended_at') %></th>
          <th><%= t('super_admin.account_suspension.history.category') %></th>
          <th><%= t('super_admin.account_suspension.history.reason') %></th>
          <th><%= t('super_admin.account_suspension.history.suspended_by') %></th>
        </tr>
      </thead>
      <tbody>
        <% field.events.each do |event| %>
          <tr class="align-top">
            <td class="whitespace-nowrap"><%= field.suspended_at(event) %></td>
            <td class="whitespace-nowrap"><%= field.category_label(event) %></td>
            <td class="whitespace-pre-wrap break-words"><%= event.fetch('reason') %></td>
            <td><%= field.suspended_by(event) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="p-4 text-body-main text-n-slate-11"><%= t('super_admin.account_suspension.history.empty') %></p>
<% end %>
