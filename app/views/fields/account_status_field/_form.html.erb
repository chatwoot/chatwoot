<%
  if f.object.persisted?
    submitted_account = params[:account]
    latest_suspension = field.resource.suspended? ? field.latest_suspension : {}
    category = submitted_account&.key?(:suspension_category) ? submitted_account[:suspension_category] : latest_suspension['category']
    reason = submitted_account&.key?(:suspension_reason) ? submitted_account[:suspension_reason] : latest_suspension['reason']
    suspension_selected = field.data == 'suspended'
  end
  detail_label = 'text-label-small text-n-slate-11'
%>

<%= render "field", f: f, field: field do %>
  <div data-account-suspension-form data-original-status="<%= field.original_status %>" data-has-suspension-history="<%= field.resource.suspension_history.present? %>">
    <%= f.select(
          field.attribute,
          options_for_select(field.selectable_options, field.data),
          { include_blank: field.include_blank_option },
          { class: ui(:select), data: { account_status_select: true } }
        ) %>

    <% if f.object.persisted? %>
      <%= tag.div class: class_names("mt-4 space-y-4", hidden: !suspension_selected), data: { account_suspension_fields: true } do %>
        <div>
          <%= label_tag :account_suspension_category, t('super_admin.account_suspension.form.category'), class: detail_label %>
          <%= select_tag(
                'account[suspension_category]',
                options_for_select(
                  [[t('super_admin.account_suspension.form.category_prompt'), '']] + field.suspension_category_options,
                  category
                ),
                id: :account_suspension_category,
                disabled: !suspension_selected,
                class: "#{ui(:select)} mt-1",
                data: { suspension_category: true }
              ) %>
        </div>
        <div>
          <%= label_tag :account_suspension_reason, t('super_admin.account_suspension.form.reason'), class: detail_label %>
          <%= text_area_tag(
                'account[suspension_reason]',
                reason,
                id: :account_suspension_reason,
                rows: 4,
                maxlength: 256,
                disabled: !suspension_selected,
                class: "#{ui(:input)} mt-1",
                data: { suspension_reason: true }
              ) %>
          <p class="mt-1 <%= detail_label %>"><%= t('super_admin.account_suspension.form.reason_hint') %></p>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
