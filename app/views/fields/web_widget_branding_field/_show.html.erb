<% widgets = field.resource.web_widgets.includes(:inbox).order('inboxes.name') %>
<% if widgets.any? %>
  <div class="grid grid-cols-1 gap-2">
    <% widgets.each do |widget| %>
      <div class="flex items-center justify-between p-2">
        <div class="flex flex-col">
          <span class="text-sm font-medium text-slate-700"><%= widget.inbox.name %></span>
          <span class="text-xs text-slate-500"><%= widget.website_url %></span>
        </div>
        <span class="text-sm text-slate-600">
          <%= widget.disable_branding ? 'Branding disabled' : 'Branding enabled' %>
        </span>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-sm text-slate-500">No web widget inboxes for this account.</p>
<% end %>
