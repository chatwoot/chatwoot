# Configuração para Docker Development Environment com NGROK

# Banco de dados PostgreSQL (container)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=chatwoot123
POSTGRES_DATABASE=chatwoot

# Redis (container)
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=chatwoot123

# Rails
RAILS_ENV=development
SECRET_KEY_BASE=your_secret_key_base_here_will_be_generated_automatically
FRONTEND_URL=https://beagle-great-awfully.ngrok-free.app

# Mailer (Mailhog container para desenvolvimento)
MAILER_SENDER_EMAIL=Chatwoot <noreply@beagle-great-awfully.ngrok-free.app>
SMTP_DOMAIN=beagle-great-awfully.ngrok-free.app
SMTP_ADDRESS=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_TLS=false

# Application settings
RAILS_LOG_TO_STDOUT=true
RAILS_MAX_THREADS=5
LOG_LEVEL=info

# Para ambiente Docker
NODE_ENV=development
INSTALLATION_ENV=docker

# Vite Dev Server
VITE_DEV_SERVER_HOST=vite

# Storage local para desenvolvimento
ACTIVE_STORAGE_SERVICE=local

# Desabilitar features não necessárias para desenvolvimento
ENABLE_ACCOUNT_SIGNUP=true
CHATWOOT_SUPPORT_IDENTIFIER_HASH=
ANALYTICS_TOKEN=
CHATWOOT_SUPPORT_SCRIPT_URL=
CHATWOOT_SUPPORT_WEBSITE_TOKEN=
CHATWOOT_INBOX_TOKEN=
CHATWOOT_INBOX_HMAC_KEY=
CHATWOOT_HUB_URL=https://beagle-great-awfully.ngrok-free.app
HELP_CENTER_ANALYTICS_ID=
DISABLE_TELEMETRY=true

# Configurações específicas para NGROK
NGROK_URL=https://beagle-great-awfully.ngrok-free.app
NGROK_DOMAIN=beagle-great-awfully.ngrok-free.app 