+        unless button['payload'].present?
+          Rails.logger.error "[SOCIALWISE-INSTAGRAM-DIALOGFLOW] #{context} postback button missing required payload"
+          return false
+        end
+
+        # Validate payload length (Instagram limit: 1000 characters)
