+  
+  # Interceptar logs para capturar o comportamento
+  original_logger = Rails.logger
+  log_buffer = []
+  
+  logger_mock = Object.new
+  def logger_mock.info(msg)
+    puts msg
+    @log_buffer ||= []
+    @log_buffer << msg
+  end
+  def logger_mock.warn(msg)
+    puts msg  
+    @log_buffer ||= []
+    @log_buffer << msg
+  end
+  def logger_mock.error(msg)
+    puts msg
+    @log_buffer ||= []
+    @log_buffer << msg
+  end
+  def logger_mock.debug(msg)
+    puts msg
+    @log_buffer ||= []
+    @log_buffer << msg
+  end
