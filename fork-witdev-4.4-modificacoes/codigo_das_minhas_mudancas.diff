+        <h3>{{ $t('STICKER_MANAGEMENT.CREATE_PACK_MODAL.TITLE') }}</h3>
+        <form @submit.prevent="createPack">
+          <div class="form-group">
+            <label>{{
+              $t('STICKER_MANAGEMENT.CREATE_PACK_MODAL.PACK_NAME')
+            }}</label>
+            <input
+              v-model="newPackName"
+              type="text"
+              class="form-control"
+              :placeholder="
