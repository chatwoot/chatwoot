+```
+
+**After:**
+```javascript
+async selectSticker(sticker) {
+  this.closeModal(); // ✅ Immediate feedback
+  this.$emit('stickerSelected', sticker);
+  
+  try {
+    await api.call(); // Background processing
+  } catch (error) {
+    this.handleSendStickerError(error);
+  }
+}
+```
