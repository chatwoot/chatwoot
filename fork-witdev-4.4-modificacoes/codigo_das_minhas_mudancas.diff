+    let!(:custom_sticker1) do
+      create(:attachment,
+             account: account,
+             file_type: :image,
+             meta: { 'sticker_type' => 'custom', 'sticker_pack' => 'Company' })
+    end
+
+    let!(:custom_sticker2) do
+      create(:attachment,
+             account: account,
+             file_type: :image,
+             meta: { 'sticker_type' => 'custom', 'sticker_pack' => 'Fun' })
+    end
+
+    let!(:regular_attachment) do
+      create(:attachment,
+             account: account,
+             file_type: :image,
+             meta: { 'type' => 'regular' })
+    end
+
+    let!(:other_account_sticker) do
+      create(:attachment,
+             account: create(:account),
+             file_type: :image,
+             meta: { 'sticker_type' => 'custom', 'sticker_pack' => 'Other' })
+    end
+
+    before do
+      Rails.cache.clear
+    end
