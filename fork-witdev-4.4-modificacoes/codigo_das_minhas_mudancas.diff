+             content_attributes: {
+               'items' => [
+                 {
+                   'title' => 'Product Card',
+                   'description' => 'Product Description',
+                   'media_url' => 'https://example.com/image.jpg',
+                   'actions' => [
+                     {
+                       'type' => 'link',
+                       'text' => 'View More',
+                       'uri' => 'https://example.com/product'
