+
+    api_url = "#{facebook_api_base_url}/#{inbox.channel.page_id}/messages"
+
+    Rails.logger.info "[SOCIALWISE-FLOW] Facebook text API URL: #{api_url}"
+
+    response = HTTParty.post(
