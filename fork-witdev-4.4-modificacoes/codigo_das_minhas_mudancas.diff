+              "
+              required
+            />
+          </div>
+          <div class="modal-actions">
+            <Button variant="hollow" @click="closeCreatePackModal">
+              {{ $t('STICKER_MANAGEMENT.CANCEL') }}
+            </Button>
+            <Button
+              type="submit"
+              color-scheme="primary"
+              :loading="isCreatingPack"
+            >
+              {{ $t('STICKER_MANAGEMENT.CREATE') }}
+            </Button>
+          </div>
+        </form>
+      </div>
+    </div>
+  </SettingsLayout>
+</template>
+
