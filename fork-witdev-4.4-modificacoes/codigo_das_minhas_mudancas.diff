+    @size = size_kb * 1024
+    @content_type = 'image/webp'
+    # Simular conteúdo WebP estático
+    @content = "RIFF" + "WEBP" + ("A" * (@size - 8))
+  end
+  
+  def read
+    @content
+  end
+  
+  def rewind
+  end
