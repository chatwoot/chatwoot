+require_relative 'config/environment'
+
+puts '🔍 DEBUG: Investigando erro na otimização'
+puts '=' * 50
+
+begin
+  file_path = '/app/app/uploaders/teste-stiker.webp'
+  puts "📁 Arquivo: #{file_path}"
+  puts "📊 Tamanho: #{File.size(file_path)} bytes"
