+//       useAlert(errorData.error || t('STICKER_MANAGEMENT.PACK_UPDATE_ERROR'));
+//     }
+//   } catch (error) {
+//     useAlert(t('STICKER_MANAGEMENT.PACK_UPDATE_ERROR'));
+//   } finally {
