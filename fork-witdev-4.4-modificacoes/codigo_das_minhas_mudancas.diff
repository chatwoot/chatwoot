+  def validate_sticker_id!(sticker_id)
+    raise ValidationError, 'Sticker ID is required' if sticker_id.blank?
+    raise ValidationError, 'Invalid sticker ID format' unless sticker_id.to_s.match?(/\A\d+\z/)
+  end
