{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.chatwoot.com/schemas/captain/provider-pack-sources-v1.json",
  "title": "Captain Provider Pack Sources",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "revision", "license", "reviewed_at"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
