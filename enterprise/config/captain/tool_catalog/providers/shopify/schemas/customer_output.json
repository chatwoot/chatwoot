{
  "type": "object",
  "additionalProperties": false,
  "required": ["customers"],
  "properties": {
    "customers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes"],
      "properties": {
        "nodes": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "displayName", "tags", "amountSpent"],
            "properties": {
              "id": { "type": "string" },
              "displayName": { "type": "string" },
              "defaultEmailAddress": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "properties": { "emailAddress": { "type": "string" } }
              },
              "defaultPhoneNumber": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "properties": { "phoneNumber": { "type": "string" } }
              },
              "tags": {
                "type": "array",
                "maxItems": 10,
                "items": { "type": "string" }
              },
              "amountSpent": {
                "type": "object",
                "additionalProperties": false,
                "required": ["amount", "currencyCode"],
                "properties": {
                  "amount": { "type": "string" },
                  "currencyCode": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
