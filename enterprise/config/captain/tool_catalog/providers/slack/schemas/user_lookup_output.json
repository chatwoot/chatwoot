    "user": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "real_name": { "type": "string" },
        "is_bot": { "type": "boolean" },
        "profile": {
          "type": "object",
