{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["message_reference", "text"],
  "properties": {
    "message_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  }
}
