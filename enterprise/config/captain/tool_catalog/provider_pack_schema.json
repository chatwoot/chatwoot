{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.chatwoot.com/schemas/captain/provider-pack-v1.json",
  "title": "Captain Provider Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "key",
    "name",
    "description",
    "api_version",
    "authentication",
    "allowed_origins",
    "categories",
    "operations",
    "templates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "key": {
      "$ref": "#/definitions/key"
    },
    "name": {
      "$ref": "#/definitions/non_empty_string"
    },
    "description": {
      "$ref": "#/definitions/non_empty_string"
    },
    "api_version": {
      "$ref": "#/definitions/non_empty_string"
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": {
          "enum": ["oauth", "restricted_key"]
        }
      }
    },
        "allowed_origins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
          "items": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              {
                "const": "https://*.myshopify.com"
              }
            ]
          }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/category"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/operation"
      }
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/template"
      }
    }
  },
  "definitions": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "description"],
      "properties": {
        "key": {
          "$ref": "#/definitions/key"
        },
        "name": {
          "$ref": "#/definitions/non_empty_string"
        },
        "description": {
          "$ref": "#/definitions/non_empty_string"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "source", "reference", "visibility", "scopes", "risk_class", "fixtures"],
      "properties": {
        "key": {
          "$ref": "#/definitions/key"
        },
        "source": {
          "enum": ["openapi", "graphql"]
        },
        "reference": {
          "$ref": "#/definitions/non_empty_string"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "endpoint_strategy": {
          "enum": ["shopify_admin_graphql"]
        },
        "visibility": {
          "enum": ["runtime", "setup"]
        },
        "scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/non_empty_string"
          }
        },
        "risk_class": {
          "enum": ["read", "low_impact_write", "approval_required"]
        },
        "fixtures": {
          "type": "object",
          "additionalProperties": false,
          "required": ["success", "errors"],
          "properties": {
            "success": {
              "type": "string",
              "pattern": "^fixtures/[a-z0-9_./-]+\\.json$"
            },
            "errors": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^fixtures/[a-z0-9_./-]+\\.json$"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "graphql"
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "required": ["endpoint"]
              },
              {
                "required": ["endpoint_strategy"]
              }
            ]
          },
          "else": {
            "allOf": [
              {
                "not": {
                  "required": ["endpoint"]
                }
              },
              {
                "not": {
                  "required": ["endpoint_strategy"]
                }
              }
            ]
          }
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "enum": [
            "model_input",
            "contact",
            "conversation",
            "configuration",
            "step_output",
            "literal",
            "shopify_contact_query",
            "shopify_order_query",
            "linear_conversation_url",
            "linear_linked_issue_id",
            "slack_reference_channel",
            "slack_reference_timestamp"
          ]
        },
        "path": {
          "$ref": "#/definitions/non_empty_string"
        },
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "value": {}
      },
      "oneOf": [
        {
          "required": ["path"],
          "properties": {
            "source": {
              "enum": ["model_input", "contact", "conversation", "configuration"]
            }
          }
        },
        {
          "required": ["path", "step"],
          "properties": {
            "source": {
              "const": "step_output"
            }
          }
        },
        {
          "required": ["value"],
          "properties": {
            "source": {
              "const": "literal"
            }
          }
        },
        {
          "properties": {
            "source": {
              "const": "shopify_contact_query"
            }
          }
        },
        {
          "required": ["path"],
          "properties": {
            "source": {
              "const": "shopify_order_query"
            }
          }
        },
        {
          "properties": {
            "source": {
              "const": "linear_conversation_url"
            }
          }
        },
        {
          "required": ["path", "step"],
          "properties": {
            "source": {
              "const": "linear_linked_issue_id"
            }
          }
        },
        {
          "required": ["path"],
          "properties": {
            "source": {
              "enum": ["slack_reference_channel", "slack_reference_timestamp"]
            }
          }
        }
      ]
    },
    "recipe_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_key", "bindings"],
      "properties": {
        "operation_key": {
          "$ref": "#/definitions/key"
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/binding"
          }
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "version",
        "name",
        "description",
        "category_key",
        "availability",
        "input_schema",
        "configuration_schema",
        "output_schema",
        "recipe"
      ],
      "properties": {
        "key": {
          "$ref": "#/definitions/key"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "name": {
          "$ref": "#/definitions/non_empty_string"
        },
        "description": {
          "$ref": "#/definitions/non_empty_string"
        },
        "category_key": {
          "$ref": "#/definitions/key"
        },
        "availability": {
          "enum": ["available", "planned", "approval_required"]
        },
        "input_schema": {
          "type": "string",
          "pattern": "^schemas/[a-z0-9_/-]+\\.json$"
        },
        "configuration_schema": {
          "type": "string",
          "pattern": "^schemas/[a-z0-9_/-]+\\.json$"
        },
        "output_schema": {
          "type": "string",
          "pattern": "^schemas/[a-z0-9_/-]+\\.json$"
        },
        "recipe": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/definitions/recipe_step"
          }
        }
      }
    }
  }
}
