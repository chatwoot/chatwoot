<tr>
  <td style="padding: 0 0 12px;">
    <h1 style="margin: 0; font-size: 24px; line-height: 32px; font-weight: 700; color: #0F172A;">Your verification code</h1>
  </td>
</tr>
<tr>
  <td style="padding: 0 0 16px;">
    <p style="margin: 0; font-size: 14px; line-height: 21px; color: #475569;">Enter this code in your chat with {{inbox_name | escape}} to confirm this email address. It expires in {{expires_in_minutes}} minutes.</p>
  </td>
</tr>
<tr>
  <td style="padding: 0 0 24px;">
    <div style="border: 1px solid #DCE7F5; border-radius: 16px; background-color: #F8FBFF; padding: 20px; text-align: center;">
      <span style="font-size: 32px; line-height: 38px; font-weight: 700; letter-spacing: 8px; color: #0F172A;">{{code}}</span>
    </div>
  </td>
</tr>
<tr>
  <td style="padding: 0 0 12px;">
    <p style="margin: 0; font-size: 14px; line-height: 21px; color: #475569;">If you did not ask for this code, you can ignore this email. Do not share the code with anyone else.</p>
  </td>
</tr>
