<%
  premium_features = Internal::Accounts::InternalAttributesService.new(field.resource).valid_feature_list
  selected_features = field.selected_features
  feature_flags = premium_features.index_with { |feature| selected_features.include?(feature) }
%>

<div class="field-unit__label">
  <%= f.label :manually_managed_features %>
</div>
<div class="field-unit__field feature-container space-y-8">
  <p class="text-gray-400 text-xs italic mb-4">Features that remain enabled even when account plan is downgraded</p>

  <% SuperAdmin::AccountFeaturesHelper.grouped_features(feature_flags).each do |section| %>
    <div>
      <h3 class="text-sm font-semibold text-slate-800 mb-3"><%= section[:label] %></h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% section[:items].each do |item| %>
          <div class="flex items-start justify-between gap-3 p-3 bg-white rounded-lg shadow-sm outline outline-1 outline-n-container">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <span class="text-sm text-slate-700 font-medium"><%= item[:display_name] %></span>
                <% if item[:plan_tier_label].present? %>
                  <span class="shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-slate-600">
                    <%= item[:plan_tier_label] %>
                  </span>
                <% end %>
              </div>
              <% if item[:description].present? %>
                <p class="text-xs text-slate-500 mt-1 mb-0 line-clamp-2"><%= item[:description] %></p>
              <% end %>
            </div>
            <span class="shrink-0 pt-0.5">
              <%= check_box_tag "account[manually_managed_features][]",
                                item[:key],
                                item[:enabled],
                                class: "h-4 w-4 rounded border-slate-300 text-violet-600 focus:ring-violet-600" %>
            </span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <hr class="my-8 border-t border-n-weak">

  <%= hidden_field_tag "account[manually_managed_features][]", "", id: nil %>
</div>