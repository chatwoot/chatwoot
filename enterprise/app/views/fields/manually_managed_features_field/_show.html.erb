<% display_names = SuperAdmin::AccountFeaturesHelper.feature_display_names %>
<% if field.selected_features.present? %>
  <p class="mb-2 text-label-small text-n-slate-11"><%= t("super_admin.features.manually_managed_hint") %></p>
  <div class="flex flex-wrap gap-1.5">
    <% field.selected_features.each do |feature| %>
      <%= render "badge", label: display_names[feature] || feature.humanize, tone: :success %>
    <% end %>
  </div>
<% else %>
  <p class="text-n-slate-11"><%= t("super_admin.features.manually_managed_empty") %></p>
<% end %>
