<%
  selected_features = field.selected_features
  feature_flags = selected_features.index_with { true }
%>

<% if selected_features.present? %>
  <div class="w-full space-y-8">
    <p class="text-gray-400 text-xs italic mb-2">Features that remain enabled even when account plan is downgraded</p>

    <% SuperAdmin::AccountFeaturesHelper.grouped_features(feature_flags).each do |section| %>
      <div>
        <h3 class="text-sm font-semibold text-n-slate-12 mb-3"><%= section[:label] %></h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          <% section[:items].each do |item| %>
            <div class="flex items-start justify-between gap-3 p-3 bg-white rounded-md outline outline-n-container outline-1 shadow-sm">
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                  <span class="text-sm text-n-slate-12 font-medium"><%= item[:display_name] %></span>
                  <% if item[:plan_tier_label].present? %>
                    <span class="shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-slate-600">
                      <%= item[:plan_tier_label] %>
                    </span>
                  <% end %>
                </div>
                <% if item[:description].present? %>
                  <p class="text-xs text-n-slate-11 mt-1 mb-0 line-clamp-2"><%= item[:description] %></p>
                <% end %>
              </div>
              <span class="bg-green-400 text-white rounded-full p-1 inline-flex right-4 top-5">
                <svg width="12" height="12"><use xlink:href="#icon-tick-line" /></svg>
              </span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <hr class="my-8 border-t border-n-weak">
  </div>
<% else %>
  <p class="text-gray-400 text-xs italic">No manually managed features configured</p>
<% end %>