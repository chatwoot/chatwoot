<%
  regular_features, premium_features = SuperAdmin::AccountFeaturesHelper.partition_features(field.data)
  groups = { t("super_admin.features.title") => regular_features, t("super_admin.features.premium") => premium_features }
  total_count = groups.sum { |_title, features| features.size }
  enabled_count = groups.sum { |_title, features| features.values.count(&:present?) }
  icons = SuperAdmin::AccountFeaturesHelper.feature_icons
  help_urls = SuperAdmin::AccountFeaturesHelper.feature_help_urls
%>
<div data-filter-scope>
  <%= render "filter_bar", states: {
    all: "#{t("super_admin.filters.all")} #{total_count}",
    on: "#{t("super_admin.features.enabled")} #{enabled_count}",
    off: "#{t("super_admin.features.disabled")} #{total_count - enabled_count}"
  } %>

  <div class="space-y-5">
    <% groups.each do |title, features| %>
      <%= render "card", title: title, meta: t("super_admin.features.enabled_count", enabled: features.values.count(&:present?), total: features.size), data: { filter_group: true } do %>
        <div class="grid grid-cols-1 gap-2 p-4 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
          <% features.each do |(feature_key, display_name), val| %>
            <div class="<%= class_names("flex min-h-10 items-center gap-2.5 rounded-lg border border-n-weak px-3 py-1.5", "bg-n-slate-2 text-n-slate-10 dark:bg-n-solid-2" => val.blank?) %>" data-filter-item data-state="<%= val.present? ? 'on' : 'off' %>">
              <span class="<%= class_names(icons[feature_key], "size-4 shrink-0", val.present? ? "text-n-slate-11" : "opacity-60 grayscale") %>"></span>
              <span class="min-w-0 flex-1 truncate"><%= display_name %></span>
              <%= render "help_link", url: help_urls[feature_key] if help_urls[feature_key] %>
              <span class="<%= val.present? ? 'i-lucide-circle-check text-n-teal-10' : 'i-lucide-circle-minus text-n-slate-8' %> size-4 shrink-0"></span>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <p class="hidden py-8 text-center text-n-slate-11" data-filter-empty><%= t("super_admin.features.no_match") %></p>
</div>
