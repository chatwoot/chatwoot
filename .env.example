# =============================================================================
# Chatwoot — local (réplica Dokploy)
# Copiar este archivo a .env y completar los valores reales.
# NUNCA commitear el archivo .env real.
#
# Docker Compose: si un valor contiene $, escapar como $$ (ej. pa$$word).
# =============================================================================

SECRET_KEY_BASE=REEMPLAZAR_CON_SECRET_KEY_BASE_GENERADO

# Active Record Encryption keys (required for MFA/2FA functionality)
# Generate these keys by running: rails db:encryption:init
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

# OpenSearch / Elasticsearch-compatible search config (optional)
# OPENSEARCH_URL=
# OPENSEARCH_API_KEY=
# ELASTICSEARCH_API_KEY=

# Restrict libvips to trusted image loaders when Active Storage generates variants.
VIPS_BLOCK_UNTRUSTED=1

RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
DEFAULT_LOCALE=en
FORCE_SSL=false

# Hostnames del compose docker-compose.dokploy.yml (NO cambiar en local)
POSTGRES_HOST=chatwoot-postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=REEMPLAZAR_CON_PASSWORD_FUERTE
REDIS_URL=redis://chatwoot-redis:6379

# Agent presence TTL (seconds). Client pings every 60s; keep this > ping interval
# so background tabs don't look offline immediately. Default in code: 90.
PRESENCE_DURATION=90

ENABLE_ACCOUNT_SIGNUP=false
ACTIVE_STORAGE_SERVICE=local

# Local: abre http://localhost:3000 en el navegador
FRONTEND_URL=http://localhost:3000

# Local dev: evita 429 en /widget al recargar test-chat.html (límite: 5/hora)
ENABLE_RACK_ATTACK_WIDGET_API=false

# Local dev: permite webhooks a Panel AI en red Docker (IPs privadas)
# En producción debe ser false.
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=true

MAILER_DELIVERY_METHOD=smtp
SMTP_ADDRESS=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_USERNAME=REEMPLAZAR_CON_USUARIO_BREVO
SMTP_PASSWORD=REEMPLAZAR_CON_SMTP_KEY_BREVO
SMTP_DOMAIN=paluhub.com
MAILER_SENDER_EMAIL=soporte@paluhub.com

# Panel AI one-click SSO (mismo PANEL_SSO_SHARED_SECRET que en Panel)
PANEL_AI_PUBLIC_URL=http://localhost:3010
PANEL_SSO_SHARED_SECRET=REEMPLAZAR_CON_SECRETO_SSO_COMPARTIDO

# --- Upstream optional (see upstream .env.example for full list) ---
# ENABLE_PUSH_RELAY_SERVER=true
# ENABLE_RACK_ATTACK=true
# ENABLE_RACK_ATTACK_WIDGET_API=true
# SAFE_FETCH_ALLOW_PRIVATE_NETWORK=false
# DIRECT_UPLOADS_ENABLED=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
