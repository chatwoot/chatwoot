{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myinvest-pro.de/schemas/chat-import/message-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["external_id", "conversation_external_id", "direction", "content", "created_at", "updated_at", "attachments"],
  "properties": {
    "external_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "conversation_external_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "direction": { "enum": ["incoming", "outgoing", "note"] },
    "content": { "type": "string", "maxLength": 150000 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "attachments": { "type": "array", "maxItems": 0 },
    "metadata": { "type": "object" }
  }
}
